record schm.evnt {
  version = 1
  fields  = [
    { name = "name", type = "str", required = true, doc = "Event display name (the record slug is the event/graph id)" },
    { name = "steps", type = "list<dict>", required = true, ordered = true, doc = "The typed event chain (spec 8 atoms): step 0 is the trigger ({ op = On* }), each following step one effect/op with its flat params ({ op = Navigate, screen = europe }). A step may carry args = { <pin> = { op = ..., ...params } } -- flat single-consumer data producers (GetState/Formula/Constant/Roll/... emitting on their value pin) feeding the step's value pins, e.g. popup %NUMBER fills. Compiles deterministically to a node graph for the interpreter; a canvas save that still fits decompiles back here, one that gains branches/exec fan-out/shared producers reclassifies to grph" },
    { name = "comments", type = "list<dict>", ordered = true, doc = "Canvas annotations, lossless: [{ text, x, y }] -- compiled to Comment nodes (no behavior)" },
    { name = "notes", type = "str", doc = "Free prose" }
  ]
}
