record schm.evnt {
  version = 1
  fields  = [
    { name = "name", type = "str", required = true, doc = "Event display name (the record slug is the event/graph id)" },
    { name = "vars", type = "list<dict>", ordered = true, doc = "The data producers (GetState/Formula/Constant/Roll/TableLookup/...), hoisted out of the exec flow: { do = <Type>, id = <original node id>, ...params, args = { <pin> = \"$<var>\" } }. ('do' is the type key -- 'op' is taken: Math/Compare carry a real param named op.) A var may reference other vars (a DAG -- combat chains atk/def through total/cmp); sharing is exact (one node, many consumers -- an impure Roll rolls once). Sorted by id (order not semantic, fixed for byte-stable round trips)" },
    { name = "steps", type = "list<dict>", required = true, ordered = true, doc = "The typed exec tree (spec 8 atoms): step 0 of the top list is the trigger ({ do = On* }); each step one op with its flat params, args = { <pin> = \"$<var>\" } data feeds, and branches = [{ pin = <exec label: true/false, switch cases 1/2/default, popup choice text>, steps = [ ...nested... ] }] sorted by pin. The 'out' continuation is simply the next step in the enclosing list. Exec JOINS are tail-duplicated (behavior identical -- each run walks one path); cycles/multi-trigger/mixed-pin shapes fall back to grph. Compiles deterministically to a node graph for the unchanged interpreter (synthetic step ids are '#'-prefixed, never colliding with authored ids); canvas saves decompile back (or reclassify to grph)" },
    { name = "comments", type = "list<dict>", ordered = true, doc = "Canvas annotations, lossless: [{ text, x, y }] -- compiled to Comment nodes (no behavior)" },
    { name = "notes", type = "str", doc = "Free prose" }
  ]
}
