record grph.trade_route {
  name  = "Trade Route"
  nodes = [{ id = "note", params = { text = "Selling goods in Europe is a PLAYER MENU COMMAND (OnPlayerCommand), not an automatic per-turn sale. When invoked it sells the cargo at the European price less the Crown's tax cut and credits the net to the treasury (@ shows the sale)." }, type = "Comment", x = 20, y = -90 }, { id = "trig", params = { }, type = "OnPlayerCommand", x = 20, y = 40 }, { id = "net", params = { expr = "100*@CARGO[10].price_start1 - 100*@CARGO[10].price_start1*power0.tax/100" }, type = "Formula", x = 20, y = 150 }, { id = "taxtaken", params = { expr = "100*@CARGO[10].price_start1*power0.tax/100" }, type = "Formula", x = 20, y = 220 }, { id = "credit", params = { power = "0" }, type = "GrantGold", x = 220, y = 40 }, { id = "pop", params = { body = "The cargo sells for {%NUMBER0} gold after the Crown takes {%NUMBER1} in tax.", choices = "Good trade.", title = "Goods Sold in Europe" }, type = "ShowPopup", x = 420, y = 40 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "credit", pin = "in" } }, { from = { node = "net", pin = "value" }, to = { node = "credit", pin = "amount" } }, { from = { node = "credit", pin = "out" }, to = { node = "pop", pin = "in" } }, { from = { node = "net", pin = "value" }, to = { node = "pop", pin = "num0" } }, { from = { node = "taxtaken", pin = "value" }, to = { node = "pop", pin = "num1" } }]
}
