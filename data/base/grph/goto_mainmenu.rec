record grph.goto_mainmenu {
  name  = "Go to mainmenu"
  nodes = [{ id = "t", params = { }, type = "OnTestFire", x = 40, y = 60 }, { id = "nav", params = { screen = "mainmenu" }, type = "Navigate", x = 240, y = 60 }]
  edges = [{ from = { node = "t", pin = "out" }, to = { node = "nav", pin = "in" } }]
}
