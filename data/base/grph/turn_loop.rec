record grph.turn_loop {
  name  = "Turn Loop (events)"
  nodes = [{ id = "note", params = { text = "Turn loop EVENT layer (spec/systems/turn_dispatch.md): fires the per-turn event graphs in spec phase order. The SIM MECHANICS (production, price drift, immigration accrual, REF accrual, cadence) are owned by the data-driven turn pipeline (turn.json / run_turn) and are NOT duplicated here -- doing both double-advanced the turn. This graph is the events only." }, type = "Comment", x = 30, y = -70 }, { id = "trig", params = { }, type = "OnTurnStart", x = 30, y = 40 }, { id = "c1", params = { text = "Phase 1: King's tax & mercenary offers" }, type = "Comment", x = 210, y = -10 }, { id = "c3", params = { text = "Phase 3: Immigration event (docks/recruit)" }, type = "Comment", x = 650, y = -10 }, { id = "c4", params = { text = "Phase 4: Diplomacy, natives & random events" }, type = "Comment", x = 870, y = -10 }, { id = "c5", params = { text = "Phase 5: Continental Congress & revolution" }, type = "Comment", x = 1090, y = -10 }, { id = "tax", params = { graph = "kings_tax" }, type = "FireEvent", x = 210, y = 40 }, { id = "merc", params = { graph = "mercenaries" }, type = "FireEvent", x = 210, y = 130 }, { id = "imm", params = { graph = "immigration" }, type = "FireEvent", x = 650, y = 40 }, { id = "raid", params = { graph = "native_raid" }, type = "FireEvent", x = 870, y = 40 }, { id = "lost", params = { graph = "lost_city" }, type = "FireEvent", x = 870, y = 130 }, { id = "ff", params = { graph = "founding_father" }, type = "FireEvent", x = 1090, y = 40 }, { id = "rev", params = { graph = "revolution" }, type = "FireEvent", x = 1090, y = 130 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "tax", pin = "in" } }, { from = { node = "tax", pin = "out" }, to = { node = "merc", pin = "in" } }, { from = { node = "merc", pin = "out" }, to = { node = "imm", pin = "in" } }, { from = { node = "imm", pin = "out" }, to = { node = "raid", pin = "in" } }, { from = { node = "raid", pin = "out" }, to = { node = "lost", pin = "in" } }, { from = { node = "lost", pin = "out" }, to = { node = "ff", pin = "in" } }, { from = { node = "ff", pin = "out" }, to = { node = "rev", pin = "in" } }]
}
