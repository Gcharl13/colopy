record grph.native_mission {
  name  = "Native Mission"
  nodes = [{ id = "note", params = { text = "Mission founding + conversion (spec/systems/natives.md func_0572E6), rebuilt. Reaction follows the tribe's attitude band (@MISSION0 curiosity .. @MISSION3 hostility). Conversion roll: P(convert)=(TribeQuality+2)/15 -- roll(0,15) < threshold; TribeQuality is read live from @TRIBES[tribe].level (here tribe 0 = Incas)." }, type = "Comment", x = 20, y = -110 }, { id = "trig", params = { }, type = "OnMissionAttempt", x = 20, y = 40 }, { id = "year", params = { path = "game.year" }, type = "GetState", x = 20, y = 150 }, { id = "band", params = { expr = "(natives.tension>=25)+(natives.tension>=50)+(natives.tension>=75)" }, type = "Formula", x = 20, y = 230 }, { id = "sw", params = { }, type = "Switch", x = 220, y = 40 }, { id = "p0", params = { choices = "Preach the Word", textKey = "@MISSION0" }, type = "ShowPopup", x = 420, y = 20 }, { id = "p1", params = { choices = "Preach the Word", textKey = "@MISSION1" }, type = "ShowPopup", x = 420, y = 90 }, { id = "p2", params = { choices = "Preach the Word", textKey = "@MISSION2" }, type = "ShowPopup", x = 420, y = 160 }, { id = "p3", params = { choices = "Preach the Word", textKey = "@MISSION3" }, type = "ShowPopup", x = 420, y = 230 }, { id = "quality", params = { column = "level", section = "@TRIBES" }, type = "TableLookup", x = 420, y = 330 }, { id = "z", params = { value = 0 }, type = "Constant", x = 420, y = 400 }, { id = "conv", params = { expr = "roll(0,15) < (a + 2)" }, type = "Formula", x = 620, y = 330 }, { id = "cbr", params = { }, type = "Branch", x = 640, y = 40 }, { id = "spawn", params = { power = "0", type = "Colonists" }, type = "SpawnUnit", x = 840, y = 40 }, { id = "cpop", params = { choices = "Welcome, brother.", textKey = "@INDIANSCONVERT" }, type = "ShowPopup", x = 1040, y = 40 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "sw", pin = "in" } }, { from = { node = "band", pin = "value" }, to = { node = "sw", pin = "value" } }, { from = { node = "year", pin = "value" }, to = { node = "p0", pin = "num0" } }, { from = { node = "p0", pin = "Preach the Word" }, to = { node = "cbr", pin = "in" } }, { from = { node = "year", pin = "value" }, to = { node = "p1", pin = "num0" } }, { from = { node = "p1", pin = "Preach the Word" }, to = { node = "cbr", pin = "in" } }, { from = { node = "year", pin = "value" }, to = { node = "p2", pin = "num0" } }, { from = { node = "p2", pin = "Preach the Word" }, to = { node = "cbr", pin = "in" } }, { from = { node = "year", pin = "value" }, to = { node = "p3", pin = "num0" } }, { from = { node = "p3", pin = "Preach the Word" }, to = { node = "cbr", pin = "in" } }, { from = { node = "sw", pin = "default" }, to = { node = "p0", pin = "in" } }, { from = { node = "sw", pin = "1" }, to = { node = "p1", pin = "in" } }, { from = { node = "sw", pin = "2" }, to = { node = "p2", pin = "in" } }, { from = { node = "sw", pin = "3" }, to = { node = "p3", pin = "in" } }, { from = { node = "z", pin = "value" }, to = { node = "quality", pin = "index" } }, { from = { node = "quality", pin = "value" }, to = { node = "conv", pin = "a" } }, { from = { node = "conv", pin = "value" }, to = { node = "cbr", pin = "cond" } }, { from = { node = "cbr", pin = "true" }, to = { node = "spawn", pin = "in" } }, { from = { node = "spawn", pin = "out" }, to = { node = "cpop", pin = "in" } }]
}
