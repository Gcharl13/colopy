record grph.terrain_improvement {
  name  = "Terrain Improvement"
  nodes = [{ id = "note", params = { text = "Pioneer terrain improvement (spec/systems/terrain_improvement.md func_040656 clear/plow, func_0409D6 road). A Pioneer holds the order for several turns: work-counter (+0x16) increments each turn until it reaches the per-terrain threshold (clear/plow = terrain_table+2, road = terrain_table), HALVED for a Hardy Pioneer. On completion 20 tools are spent and the tile byte changes: CLEAR forest = terrain id - 8 (+ lumber to the colony), PLOW = set bit 0x40 (+1 crop), ROAD = set bit 0x08 (movement). Switch on the order; FLAGGED: per-terrain threshold values are the @TERRAIN stride-16 table (here a Constant=4)." }, type = "Comment", x = 20, y = -130 }, { id = "trig", params = { }, type = "OnPlayerCommand", x = 20, y = 40 }, { id = "order", params = { value = 0 }, type = "Constant", x = 20, y = 160 }, { id = "sw", params = { }, type = "Switch", x = 220, y = 40 }, { id = "lumber", params = { count = 2, sides = 5 }, type = "Dice", x = 20, y = 300 }, { id = "c10", params = { value = 10 }, type = "Constant", x = 20, y = 370 }, { id = "lum", params = { op = "*" }, type = "Math", x = 180, y = 320 }, { id = "gsColony", params = { path = "@COLONYNAME[0].name" }, type = "GetState", x = 220, y = 300 }, { id = "pClear", params = { choices = "Onward.", textKey = "@CLEARCUT" }, type = "ShowPopup", x = 440, y = 40 }, { id = "pPlow", params = { body = "Pioneers plow the fields -- crop yield rises by 1 on this tile (tile bit 0x40 set). 20 tools spent.", choices = "Good.", title = "Fields Plowed" }, type = "ShowPopup", x = 440, y = 160 }, { id = "pRoad", params = { body = "Pioneers complete a road -- movement here drops to 1/3 and ore/fur/timber ease out (tile bit 0x08 set). 20 tools spent.", choices = "Good.", title = "Road Built" }, type = "ShowPopup", x = 440, y = 280 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "sw", pin = "in" } }, { from = { node = "order", pin = "value" }, to = { node = "sw", pin = "value" } }, { from = { node = "lumber", pin = "value" }, to = { node = "lum", pin = "a" } }, { from = { node = "c10", pin = "value" }, to = { node = "lum", pin = "b" } }, { from = { node = "sw", pin = "default" }, to = { node = "pClear", pin = "in" } }, { from = { node = "lum", pin = "value" }, to = { node = "pClear", pin = "num0" } }, { from = { node = "gsColony", pin = "value" }, to = { node = "pClear", pin = "str0" } }, { from = { node = "sw", pin = "1" }, to = { node = "pPlow", pin = "in" } }, { from = { node = "sw", pin = "2" }, to = { node = "pRoad", pin = "in" } }]
}
