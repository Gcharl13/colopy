record grph.kings_tax {
  name  = "King's Tax Demand"
  nodes = [{ id = "note", params = { text = "King's tax demand (spec/systems/king.md func_036138/034AE0/034318), rebuilt with Formula + Notify. Cadence, raise, severity and pretext bucket are each ONE Formula node referencing live variables; the four pretexts are the real @KING* messages with %NUMBER0=raise, %NUMBER1=new rate. AUDIT 2026-07-02: func_034AE0's difficulty roll gate added (tax <= candidate -> random_int(1,diff+1)==1 skips the raise, @034B25..034B30) with candidate = ((diff&0xFE)<<1 + 4)*(turn/400 + 1) (@034AEE..034B0D). The @034B10 gate reads literally as 'return when candidate+5 >= tax', which would prevent any raise from tax 0 and contradicts this cadence path -- NOT wired; flagged as a spec reconciliation question in king.md." }, type = "Comment", x = 20, y = -90 }, { id = "trig", params = { }, type = "OnTurnStart", x = 20, y = 40 }, { id = "due", params = { expr = "game.turn >= 30 && (game.turn % (game.year>=1750 ? 9 : game.year>=1700 ? 12 : game.year>=1600 ? 15 : 18)) == 0 && power0.tax <= 85 && (power0.tax > ((game.difficulty - game.difficulty%2)*2 + 4)*(floor(game.turn/400)+1) || roll(1, game.difficulty+1) != 1)" }, type = "Formula", x = 200, y = 140 }, { id = "br", params = { }, type = "Branch", x = 420, y = 40 }, { id = "delta", params = { expr = "(game.difficulty - game.difficulty%2)*2 + 4" }, type = "Formula", x = 200, y = 260 }, { id = "newTax", params = { expr = "min(power0.tax + a, 75)" }, type = "Formula", x = 200, y = 330 }, { id = "sev", params = { expr = "roll(1,1000) + (2*revolution.sol - power0.tax)*5 + power0.gold/100 + power0.econ_strength + floor(game.turn/30)" }, type = "Formula", x = 200, y = 430 }, { id = "bucket", params = { expr = "(a>=650) + (a>=950) + (a>=1100)" }, type = "Formula", x = 420, y = 430 }, { id = "sw", params = { }, type = "Switch", x = 620, y = 40 }, { id = "pWife", params = { choices = "Kiss the royal pinky ring,Hold a Party", speaker = "King", textKey = "@KINGWIFE" }, type = "ShowPopup", x = 820, y = 20 }, { id = "pWar", params = { choices = "Kiss the royal pinky ring,Hold a Party", speaker = "King", textKey = "@KINGWAR" }, type = "ShowPopup", x = 820, y = 110 }, { id = "pNav", params = { choices = "Kiss the royal pinky ring,Hold a Party", speaker = "King", textKey = "@KINGNAVACT" }, type = "ShowPopup", x = 820, y = 200 }, { id = "pStamp", params = { choices = "Kiss the royal pinky ring,Hold a Party", speaker = "King", textKey = "@KINGSTAMPACT" }, type = "ShowPopup", x = 820, y = 290 }, { id = "settax", params = { power = "0" }, type = "SetTax", x = 1100, y = 120 }, { id = "boycott", params = { good = "Tobacco" }, type = "AddBoycott", x = 1100, y = 300 }, { id = "teaparty", params = { choices = "No taxation without representation!", textKey = "@TEAPARTY" }, type = "ShowPopup", x = 1300, y = 300 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "br", pin = "in" } }, { from = { node = "due", pin = "value" }, to = { node = "br", pin = "cond" } }, { from = { node = "delta", pin = "value" }, to = { node = "newTax", pin = "a" } }, { from = { node = "sev", pin = "value" }, to = { node = "bucket", pin = "a" } }, { from = { node = "br", pin = "true" }, to = { node = "sw", pin = "in" } }, { from = { node = "bucket", pin = "value" }, to = { node = "sw", pin = "value" } }, { from = { node = "delta", pin = "value" }, to = { node = "pWife", pin = "num0" } }, { from = { node = "newTax", pin = "value" }, to = { node = "pWife", pin = "num1" } }, { from = { node = "pWife", pin = "Kiss the royal pinky ring" }, to = { node = "settax", pin = "in" } }, { from = { node = "pWife", pin = "Hold a Party" }, to = { node = "boycott", pin = "in" } }, { from = { node = "delta", pin = "value" }, to = { node = "pWar", pin = "num0" } }, { from = { node = "newTax", pin = "value" }, to = { node = "pWar", pin = "num1" } }, { from = { node = "pWar", pin = "Kiss the royal pinky ring" }, to = { node = "settax", pin = "in" } }, { from = { node = "pWar", pin = "Hold a Party" }, to = { node = "boycott", pin = "in" } }, { from = { node = "delta", pin = "value" }, to = { node = "pNav", pin = "num0" } }, { from = { node = "newTax", pin = "value" }, to = { node = "pNav", pin = "num1" } }, { from = { node = "pNav", pin = "Kiss the royal pinky ring" }, to = { node = "settax", pin = "in" } }, { from = { node = "pNav", pin = "Hold a Party" }, to = { node = "boycott", pin = "in" } }, { from = { node = "delta", pin = "value" }, to = { node = "pStamp", pin = "num0" } }, { from = { node = "newTax", pin = "value" }, to = { node = "pStamp", pin = "num1" } }, { from = { node = "pStamp", pin = "Kiss the royal pinky ring" }, to = { node = "settax", pin = "in" } }, { from = { node = "pStamp", pin = "Hold a Party" }, to = { node = "boycott", pin = "in" } }, { from = { node = "sw", pin = "default" }, to = { node = "pWife", pin = "in" } }, { from = { node = "sw", pin = "1" }, to = { node = "pWar", pin = "in" } }, { from = { node = "sw", pin = "2" }, to = { node = "pNav", pin = "in" } }, { from = { node = "sw", pin = "3" }, to = { node = "pStamp", pin = "in" } }, { from = { node = "newTax", pin = "value" }, to = { node = "settax", pin = "value" } }, { from = { node = "boycott", pin = "out" }, to = { node = "teaparty", pin = "in" } }]
