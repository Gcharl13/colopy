record grph.revolution {
  name  = "Revolution"
  nodes = [{ id = "note", params = { text = "Revolution trigger (spec/systems/revolution.md): when the national SoL allows it (can_declare_independence, >=50%), declare independence and mobilize the King's Expeditionary Force; below the floor it is silent." }, type = "Comment", x = 20, y = -80 }, { id = "trig", params = { }, type = "OnSoLThreshold", x = 20, y = 40 }, { id = "can", params = { }, type = "CanDeclareIndependence", x = 20, y = 150 }, { id = "br", params = { }, type = "Branch", x = 220, y = 40 }, { id = "decl", params = { }, type = "DeclareIndependence", x = 420, y = 40 }, { id = "ref", params = { }, type = "MobilizeREF", x = 600, y = 40 }, { id = "popI", params = { choices = "Liberty or death!", textKey = "@INDEPENDENCE" }, type = "ShowPopup", x = 780, y = 40 }, { id = "genName", params = { options = "Washington" }, type = "PickText", x = 780, y = 180 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "br", pin = "in" } }, { from = { node = "can", pin = "value" }, to = { node = "br", pin = "cond" } }, { from = { node = "br", pin = "true" }, to = { node = "decl", pin = "in" } }, { from = { node = "decl", pin = "out" }, to = { node = "ref", pin = "in" } }, { from = { node = "ref", pin = "out" }, to = { node = "popI", pin = "in" } }, { from = { node = "genName", pin = "value" }, to = { node = "popI", pin = "str0" } }]
}
