record grph.founding_father {
  name  = "Founding Father Offer"
  nodes = [{ id = "note", params = { text = "Continental Congress (spec/systems/founding_fathers.md), rebuilt table-driven. Trigger: congress.bells >= congress.cost (the byte-verified bell curve). Selection = era-weighted random over un-owned fathers; the 3 @FATHERS weight columns ARE the era bands, read live by TableLookup with col = 2 + era_band -- edit a father's weights in the Tables tab and the offer odds change. Modeled over one representative father per category (rows 0/5/11/15/21)." }, type = "Comment", x = 20, y = -120 }, { id = "trig", params = { }, type = "OnTurnStart", x = 20, y = 40 }, { id = "gate", params = { expr = "congress.bells >= congress.cost" }, type = "Formula", x = 20, y = 150 }, { id = "br", params = { }, type = "Branch", x = 220, y = 40 }, { id = "bandcol", params = { expr = "2 + congress.era_band" }, type = "Formula", x = 20, y = 250 }, { id = "w0", params = { column = "2", section = "@FATHERS" }, type = "TableLookup", x = 220, y = 250 }, { id = "w0r", params = { value = 0 }, type = "Constant", x = 20, y = 330 }, { id = "w1", params = { column = "2", section = "@FATHERS" }, type = "TableLookup", x = 220, y = 305 }, { id = "w1r", params = { value = 5 }, type = "Constant", x = 20, y = 370 }, { id = "w2", params = { column = "2", section = "@FATHERS" }, type = "TableLookup", x = 220, y = 360 }, { id = "w2r", params = { value = 11 }, type = "Constant", x = 20, y = 410 }, { id = "w3", params = { column = "2", section = "@FATHERS" }, type = "TableLookup", x = 220, y = 415 }, { id = "w3r", params = { value = 15 }, type = "Constant", x = 20, y = 450 }, { id = "w4", params = { column = "2", section = "@FATHERS" }, type = "TableLookup", x = 220, y = 470 }, { id = "w4r", params = { value = 21 }, type = "Constant", x = 20, y = 490 }, { id = "budget", params = { expr = "roll(1, a+b+c+d+e)" }, type = "Formula", x = 420, y = 250 }, { id = "pick", params = { expr = "(f>a)+(f>a+b)+(f>a+b+c)+(f>a+b+c+d)" }, type = "Formula", x = 620, y = 250 }, { id = "fid", params = { values = "0,5,11,15,21" }, type = "PickNumber", x = 820, y = 250 }, { id = "fname", params = { column = "name", section = "@FATHERS" }, type = "TableLookup", x = 820, y = 310 }, { id = "natadj", params = { path = "@NATIONALITY[0].name" }, type = "GetState", x = 820, y = 100 }, { id = "feff", params = { options = "enables factory-tier buildings,speeds the Atlantic crossing to a single turn,auto-promotes your combat winners,doubles your liberty-bell output,raises colony crosses output by half" }, type = "PickText", x = 820, y = 430 }, { id = "offer", params = { body = "The Continental Congress can appoint %STRING0, who %STRING1, for %NUMBER0 liberty bells. Shall we welcome them?", choices = "Welcome,Decline", speaker = "Statesman", title = "The Continental Congress" }, type = "ShowPopup", x = 420, y = 40 }, { id = "cost", params = { path = "congress.cost" }, type = "GetState", x = 420, y = 150 }, { id = "grant", params = { }, type = "GiveFoundingFather", x = 640, y = 40 }, { id = "ann", params = { choices = "Huzzah!", textKey = "@FREEDOM" }, type = "ShowPopup", x = 840, y = 40 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "br", pin = "in" } }, { from = { node = "gate", pin = "value" }, to = { node = "br", pin = "cond" } }, { from = { node = "w0r", pin = "value" }, to = { node = "w0", pin = "index" } }, { from = { node = "bandcol", pin = "value" }, to = { node = "w0", pin = "col" } }, { from = { node = "w1r", pin = "value" }, to = { node = "w1", pin = "index" } }, { from = { node = "bandcol", pin = "value" }, to = { node = "w1", pin = "col" } }, { from = { node = "w2r", pin = "value" }, to = { node = "w2", pin = "index" } }, { from = { node = "bandcol", pin = "value" }, to = { node = "w2", pin = "col" } }, { from = { node = "w3r", pin = "value" }, to = { node = "w3", pin = "index" } }, { from = { node = "bandcol", pin = "value" }, to = { node = "w3", pin = "col" } }, { from = { node = "w4r", pin = "value" }, to = { node = "w4", pin = "index" } }, { from = { node = "bandcol", pin = "value" }, to = { node = "w4", pin = "col" } }, { from = { node = "w0", pin = "value" }, to = { node = "budget", pin = "a" } }, { from = { node = "w1", pin = "value" }, to = { node = "budget", pin = "b" } }, { from = { node = "w2", pin = "value" }, to = { node = "budget", pin = "c" } }, { from = { node = "w3", pin = "value" }, to = { node = "budget", pin = "d" } }, { from = { node = "w4", pin = "value" }, to = { node = "budget", pin = "e" } }, { from = { node = "w0", pin = "value" }, to = { node = "pick", pin = "a" } }, { from = { node = "w1", pin = "value" }, to = { node = "pick", pin = "b" } }, { from = { node = "w2", pin = "value" }, to = { node = "pick", pin = "c" } }, { from = { node = "w3", pin = "value" }, to = { node = "pick", pin = "d" } }, { from = { node = "budget", pin = "value" }, to = { node = "pick", pin = "f" } }, { from = { node = "pick", pin = "value" }, to = { node = "fid", pin = "index" } }, { from = { node = "fid", pin = "value" }, to = { node = "fname", pin = "index" } }, { from = { node = "pick", pin = "value" }, to = { node = "feff", pin = "index" } }, { from = { node = "br", pin = "true" }, to = { node = "offer", pin = "in" } }, { from = { node = "fname", pin = "value" }, to = { node = "offer", pin = "str0" } }, { from = { node = "feff", pin = "value" }, to = { node = "offer", pin = "str1" } }, { from = { node = "cost", pin = "value" }, to = { node = "offer", pin = "num0" } }, { from = { node = "offer", pin = "Welcome" }, to = { node = "grant", pin = "in" } }, { from = { node = "fid", pin = "value" }, to = { node = "grant", pin = "father" } }, { from = { node = "grant", pin = "out" }, to = { node = "ann", pin = "in" } }, { from = { node = "fname", pin = "value" }, to = { node = "ann", pin = "str0" } }, { from = { node = "natadj", pin = "value" }, to = { node = "ann", pin = "str1" } }]
}
