record grph.native_uprising {
  name  = "Native Uprising"
  nodes = [{ id = "note", params = { text = "Native uprising (spec/systems/natives.md). A tribe rises to open war when its alarm reaches the war threshold (alarm>=128, modeled tension>=80): spike the alarm, set war, braves assault (one of @RAIDBURN/SCALP/WREAK)." }, type = "Comment", x = 20, y = -90 }, { id = "trig", params = { }, type = "OnTurnStart", x = 20, y = 40 }, { id = "gate", params = { expr = "natives.tension >= 80" }, type = "Formula", x = 20, y = 150 }, { id = "br", params = { }, type = "Branch", x = 220, y = 40 }, { id = "spike", params = { amount = 20 }, type = "ChangeNativeTension", x = 420, y = 40 }, { id = "war", params = { a = "0", b = "3" }, type = "DeclareWar", x = 600, y = 40 }, { id = "pop", params = { choices = "To the walls!", textKeys = "@RAIDBURN,@RAIDSCALP,@RAIDWREAK", woodcut = "WDCUT13" }, type = "ShowPopup", x = 780, y = 40 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "br", pin = "in" } }, { from = { node = "gate", pin = "value" }, to = { node = "br", pin = "cond" } }, { from = { node = "br", pin = "true" }, to = { node = "spike", pin = "in" } }, { from = { node = "spike", pin = "out" }, to = { node = "war", pin = "in" } }, { from = { node = "war", pin = "out" }, to = { node = "pop", pin = "in" } }]
}
