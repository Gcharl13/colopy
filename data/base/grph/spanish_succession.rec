record grph.spanish_succession {
  name  = "War of Spanish Succession"
  nodes = [{ id = "trig", params = { }, type = "OnSpanishSuccession", x = 30, y = 40 }, { id = "weak", params = { metric = "strength" }, type = "WeakestPower", x = 30, y = 170 }, { id = "strong", params = { metric = "strength" }, type = "StrongestPower", x = 30, y = 260 }, { id = "xfer", params = { }, type = "TransferColonies", x = 260, y = 40 }, { id = "pop", params = { choices = "Continue", speaker = "King", textKey = "@SUCCESSION" }, type = "ShowPopup", x = 470, y = 40 }, { id = "note", params = { text = "Victim selection (spec: rank by 3*[0x9418]+2*[0x9298]+1*[0x9410]). Now reads REAL editable per-power fields: power<N>.strength = 3*mil_strength + 2*colony_count + 1*econ_strength. colony_count is live (the decoded 0x9298); mil_strength/econ_strength are editable in the State Inspector (proxy the undecoded 0x9418/0x9410 arrays). WeakestPower cedes to StrongestPower. NOTE: @SUCCESSION also has a %STRING3 slot, but the engine only fills str0/str1/str2 and num0/num1 on ShowPopup -- there is no str3, so %STRING3 is left unsupported and unfilled." }, type = "Comment", x = 20, y = -90 }, { id = "gs_ceder", params = { path = "@NATIONALITY[2].name" }, type = "GetState", x = 260, y = 170 }, { id = "pt_cede", params = { options = "its New World possessions" }, type = "PickText", x = 260, y = 260 }, { id = "gs_benef", params = { path = "@NATIONALITY[0].name" }, type = "GetState", x = 260, y = 350 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "xfer", pin = "in" } }, { from = { node = "weak", pin = "value" }, to = { node = "xfer", pin = "from" } }, { from = { node = "strong", pin = "value" }, to = { node = "xfer", pin = "to" } }, { from = { node = "xfer", pin = "out" }, to = { node = "pop", pin = "in" } }, { from = { node = "gs_ceder", pin = "value" }, to = { node = "pop", pin = "str0" } }, { from = { node = "pt_cede", pin = "value" }, to = { node = "pop", pin = "str1" } }, { from = { node = "gs_benef", pin = "value" }, to = { node = "pop", pin = "str2" } }]
}
