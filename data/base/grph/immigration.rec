record grph.immigration {
  name  = "Religious Immigration"
  nodes = [{ id = "note", params = { text = "Religious immigration (spec/systems/immigration.md), rebuilt with Formula + TableLookup. Trigger: the accumulated crosses (power0.crosses) pass the byte-verified crosses_threshold -- base a = total colonists + units, then min(a*2+8, 4000), scaled by difficulty (8-diff)/8 and England x2/3; the spawn fires when crosses STRICTLY exceed it (jg). Arriving class = difficulty-weighted refill roll: roll(1,15) <= (diff+18)/2 picks a low tier (criminals/servants/farmers, @CLASS rows 0-2) else high tier (Trained Mercenaries 6, or Educated Elite 7 with William Brewster ff.20). Class name + recruit cost read live from @CLASS by index." }, type = "Comment", x = 20, y = -90 }, { id = "trig", params = { }, type = "OnTurnStart", x = 20, y = 40 }, { id = "gate", params = { expr = "power0.crosses > min((colonies.population + power0.units)*2 + 8, 4000)*(8-game.difficulty)/8*2/3" }, type = "Formula", x = 200, y = 150 }, { id = "br", params = { }, type = "Branch", x = 400, y = 40 }, { id = "cls", params = { expr = "roll(1,15) <= (game.difficulty+18)/2 ? roll(0,2) : (ff.20 ? 7 : 6)" }, type = "Formula", x = 200, y = 260 }, { id = "name", params = { column = "name", section = "@CLASS" }, type = "TableLookup", x = 400, y = 260 }, { id = "cost", params = { column = "transport_cost", section = "@CLASS" }, type = "TableLookup", x = 400, y = 330 }, { id = "spawn", params = { power = "0", type = "Colonists" }, type = "SpawnUnit", x = 600, y = 40 }, { id = "pop1", params = { choices = "Visit the docks", textKey = "@UNREST", woodcut = "WDCUT04" }, type = "ShowPopup", x = 780, y = 40 }, { id = "pop2", params = { choices = "Pay their passage,Leave them waiting", speaker = "Recruiter", textKey = "@RECRUIT" }, type = "ShowPopup", x = 980, y = 40 }, { id = "neg", params = { expr = "-a" }, type = "Formula", x = 980, y = 200 }, { id = "pay", params = { power = "0" }, type = "GrantGold", x = 1180, y = 40 }, { id = "ok", params = { body = "The colonist boards for the New World.", choices = "Godspeed.", title = "Passage Paid" }, type = "ShowPopup", x = 1380, y = 40 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "br", pin = "in" } }, { from = { node = "gate", pin = "value" }, to = { node = "br", pin = "cond" } }, { from = { node = "cls", pin = "value" }, to = { node = "name", pin = "index" } }, { from = { node = "cls", pin = "value" }, to = { node = "cost", pin = "index" } }, { from = { node = "br", pin = "true" }, to = { node = "spawn", pin = "in" } }, { from = { node = "spawn", pin = "out" }, to = { node = "pop1", pin = "in" } }, { from = { node = "name", pin = "value" }, to = { node = "pop1", pin = "str1" } }, { from = { node = "pop1", pin = "Visit the docks" }, to = { node = "pop2", pin = "in" } }, { from = { node = "cost", pin = "value" }, to = { node = "pop2", pin = "num0" } }, { from = { node = "cost", pin = "value" }, to = { node = "neg", pin = "a" } }, { from = { node = "pop2", pin = "Pay their passage" }, to = { node = "pay", pin = "in" } }, { from = { node = "neg", pin = "value" }, to = { node = "pay", pin = "amount" } }, { from = { node = "pay", pin = "out" }, to = { node = "ok", pin = "in" } }]
}
