record grph.independence {
  name  = "Declare Independence"
  nodes = [{ id = "note", params = { text = "Declaring independence is a PLAYER MENU COMMAND (OnPlayerCommand), never an automatic per-turn event. When invoked it checks national SoL: below 50%% it shows @TOOTORY and refuses; at/above 50%% it asks @DECLARE, and on confirm fires DeclareIndependence + MobilizeREF + the @INDEPENDENCE announcement." }, type = "Comment", x = 20, y = -90 }, { id = "trig", params = { }, type = "OnPlayerCommand", x = 20, y = 40 }, { id = "gate", params = { expr = "revolution.sol >= 50" }, type = "Formula", x = 20, y = 150 }, { id = "br", params = { }, type = "Branch", x = 220, y = 40 }, { id = "tootory", params = { choices = "We shall build more bells.", textKey = "@TOOTORY" }, type = "ShowPopup", x = 220, y = 200 }, { id = "confirm", params = { choices = "Declare independence!,Not yet", textKey = "@DECLARE" }, type = "ShowPopup", x = 420, y = 40 }, { id = "decl", params = { }, type = "DeclareIndependence", x = 620, y = 40 }, { id = "mob", params = { }, type = "MobilizeREF", x = 800, y = 40 }, { id = "ann", params = { choices = "Liberty or death!", textKey = "@INDEPENDENCE" }, type = "ShowPopup", x = 980, y = 40 }, { id = "tootory_num0", params = { path = "revolution.sol" }, type = "GetState", x = 220, y = 320 }, { id = "confirm_str0", params = { path = "@COUNTRY[0].name" }, type = "GetState", x = 420, y = 160 }, { id = "ann_str0", params = { options = "Washington" }, type = "PickText", x = 980, y = 160 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "br", pin = "in" } }, { from = { node = "gate", pin = "value" }, to = { node = "br", pin = "cond" } }, { from = { node = "br", pin = "false" }, to = { node = "tootory", pin = "in" } }, { from = { node = "br", pin = "true" }, to = { node = "confirm", pin = "in" } }, { from = { node = "confirm", pin = "Declare independence!" }, to = { node = "decl", pin = "in" } }, { from = { node = "decl", pin = "out" }, to = { node = "mob", pin = "in" } }, { from = { node = "mob", pin = "out" }, to = { node = "ann", pin = "in" } }, { from = { node = "tootory_num0", pin = "value" }, to = { node = "tootory", pin = "num0" } }, { from = { node = "confirm_str0", pin = "value" }, to = { node = "confirm", pin = "str0" } }, { from = { node = "ann_str0", pin = "value" }, to = { node = "ann", pin = "str0" } }]
}
