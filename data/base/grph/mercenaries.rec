record grph.mercenaries {
  name  = "Mercenary Offer"
  nodes = [{ id = "note", params = { text = "Mercenary offer (spec/systems/mercenary.md func_03E442): odds wartime 1-in-3 vs peacetime 1-in-21; the counts, force description and BYTE-VERIFIED price ((diff+K)*2+roll(0,6))*100 per unit are pre-rolled by MercenaryQuote BEFORE the @MERCENARIES dialog so %NUMBER0/%STRING1 bind the real offer (@0x03E4E8 odds; quote/affordability @0x03E5FD; first-call prime bit @0x03E4BC). The dialog's choice texts live in the message tail (No thank you. / Pay); choice 1 hires at exactly the quoted price." }, type = "Comment", x = 40, y = 40 }, { id = "trig", params = { }, type = "OnTurnStart", x = 40, y = 160 }, { id = "odds", params = { expr = "revolution.declared ? (roll(1,3)==1) : (roll(1,21)==1)" }, type = "Formula", x = 200, y = 220 }, { id = "br", params = { }, type = "Branch", x = 360, y = 160 }, { id = "quote", params = { }, type = "MercenaryQuote", x = 520, y = 160 }, { id = "priceF", params = { path = "game.merc_price" }, type = "GetState", x = 520, y = 300 }, { id = "forceF", params = { path = "game.merc_force" }, type = "GetState", x = 520, y = 360 }, { id = "nationF", params = { path = "@NATIONALITY[0].name" }, type = "GetState", x = 520, y = 420 }, { id = "pop", params = { choices = "No thank you.,Pay", speaker = "King", textKey = "@MERCENARIES" }, type = "ShowPopup", x = 700, y = 160 }, { id = "wdecl", params = { expr = "revolution.declared" }, type = "Formula", x = 860, y = 300 }, { id = "hbr", params = { }, type = "Branch", x = 1020, y = 160 }, { id = "hire", params = { kind = "Wartime", power = "0" }, type = "HireMercenaries", x = 1180, y = 100 }, { id = "hpeace", params = { kind = "Peacetime", power = "0" }, type = "HireMercenaries", x = 1180, y = 220 }, { id = "arr", params = { choices = "Welcome.", textKey = "@MERCS" }, type = "ShowPopup", x = 1340, y = 160 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "br", pin = "in" } }, { from = { node = "odds", pin = "value" }, to = { node = "br", pin = "cond" } }, { from = { node = "br", pin = "true" }, to = { node = "quote", pin = "in" } }, { from = { node = "quote", pin = "offer" }, to = { node = "pop", pin = "in" } }, { from = { node = "priceF", pin = "value" }, to = { node = "pop", pin = "num0" } }, { from = { node = "forceF", pin = "value" }, to = { node = "pop", pin = "str1" } }, { from = { node = "nationF", pin = "value" }, to = { node = "pop", pin = "str0" } }, { from = { node = "pop", pin = "choice1" }, to = { node = "hbr", pin = "in" } }, { from = { node = "wdecl", pin = "value" }, to = { node = "hbr", pin = "cond" } }, { from = { node = "hbr", pin = "true" }, to = { node = "hire", pin = "in" } }, { from = { node = "hbr", pin = "false" }, to = { node = "hpeace", pin = "in" } }, { from = { node = "hire", pin = "out" }, to = { node = "arr", pin = "in" } }, { from = { node = "hpeace", pin = "out" }, to = { node = "arr", pin = "in" } }]
}
