record grph.colony_rush_buy {
  name  = "Colony: Rush-Buy"
  nodes = [{ id = "note", params = { text = "Rush a project to completion with gold (the @BUYME1 dialog). The cost is RECONSTRUCTED (the binary isn't in-repo to byte-decode it; see notes/rulings/RULINGS.md): a Formula over the hammers still needed, here build_remaining*8 gold, editable inline. 'Complete it' debits the treasury and finishes the building; 'Never mind' leaves it building normally." }, type = "Comment", x = 20, y = -110 }, { id = "trig", params = { }, type = "OnPlayerCommand", x = 20, y = 40 }, { id = "cost", params = { expr = "colony0.build_remaining * 8" }, type = "Formula", x = 20, y = 160 }, { id = "dlg", params = { choices = "Never mind,Complete it", speaker = "Governor", textKey = "@BUYME1" }, type = "ShowPopup", x = 240, y = 40 }, { id = "gold", params = { path = "power0.gold" }, type = "GetState", x = 20, y = 240 }, { id = "bname", params = { path = "colony0.building_name" }, type = "GetState", x = 20, y = 320 }, { id = "rush", params = { colony = 0 }, type = "RushBuild", x = 460, y = 20 }, { id = "ok", params = { body = "{colony0.building_name} stands complete, Your Excellency.", choices = "Excellent.", title = "Project Complete" }, type = "ShowPopup", x = 660, y = 20 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "dlg", pin = "in" } }, { from = { node = "cost", pin = "value" }, to = { node = "dlg", pin = "num0" } }, { from = { node = "gold", pin = "value" }, to = { node = "dlg", pin = "num1" } }, { from = { node = "bname", pin = "value" }, to = { node = "dlg", pin = "str0" } }, { from = { node = "dlg", pin = "Complete it" }, to = { node = "rush", pin = "in" } }, { from = { node = "cost", pin = "value" }, to = { node = "rush", pin = "cost" } }, { from = { node = "rush", pin = "out" }, to = { node = "ok", pin = "in" } }]
}
