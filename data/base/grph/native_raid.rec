record grph.native_raid {
  name  = "Native Raid on Colony"
  nodes = [{ id = "note", params = { text = "Native raid (spec/systems/natives.md), rebuilt. Gate: alarm >= 128 (tension>=75). Outcome = Roll(0,4) -> Switch: 0/default nothing, 1 stores, 2 wreak, 3 gold, 4 burn. Plundered gold = 2d6*25 (one Formula), wired to @RAIDGOLD %NUMBER0 and granted (negated)." }, type = "Comment", x = 20, y = -90 }, { id = "trig", params = { }, type = "OnTurnStart", x = 20, y = 40 }, { id = "gate", params = { expr = "natives.tension >= 75" }, type = "Formula", x = 20, y = 150 }, { id = "brG", params = { }, type = "Branch", x = 220, y = 40 }, { id = "roll", params = { max = 4, min = 0 }, type = "Roll", x = 420, y = 40 }, { id = "sw", params = { }, type = "Switch", x = 600, y = 40 }, { id = "amt", params = { expr = "(roll(1,6)+roll(1,6))*25" }, type = "Formula", x = 420, y = 150 }, { id = "neg", params = { expr = "-a" }, type = "Formula", x = 420, y = 220 }, { id = "p0", params = { choices = "Jubilant!", textKey = "@RAIDNOTHING" }, type = "ShowPopup", x = 820, y = 20 }, { id = "p1", params = { choices = "Outrage!", textKey = "@RAIDSTORES", woodcut = "WDCUT12" }, type = "ShowPopup", x = 820, y = 90 }, { id = "p2", params = { choices = "Vengeance!", textKey = "@RAIDWREAK", woodcut = "WDCUT12" }, type = "ShowPopup", x = 820, y = 160 }, { id = "g3", params = { power = "0" }, type = "GrantGold", x = 820, y = 260 }, { id = "p3", params = { choices = "Enraged!", textKey = "@RAIDGOLD", woodcut = "WDCUT12" }, type = "ShowPopup", x = 1020, y = 260 }, { id = "p4", params = { choices = "Rebuild", textKey = "@RAIDBURN", woodcut = "WDCUT12" }, type = "ShowPopup", x = 820, y = 330 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "brG", pin = "in" } }, { from = { node = "gate", pin = "value" }, to = { node = "brG", pin = "cond" } }, { from = { node = "brG", pin = "true" }, to = { node = "sw", pin = "in" } }, { from = { node = "roll", pin = "value" }, to = { node = "sw", pin = "value" } }, { from = { node = "amt", pin = "value" }, to = { node = "neg", pin = "a" } }, { from = { node = "sw", pin = "3" }, to = { node = "g3", pin = "in" } }, { from = { node = "neg", pin = "value" }, to = { node = "g3", pin = "amount" } }, { from = { node = "g3", pin = "out" }, to = { node = "p3", pin = "in" } }, { from = { node = "amt", pin = "value" }, to = { node = "p3", pin = "num0" } }, { from = { node = "sw", pin = "default" }, to = { node = "p0", pin = "in" } }, { from = { node = "sw", pin = "1" }, to = { node = "p1", pin = "in" } }, { from = { node = "sw", pin = "2" }, to = { node = "p2", pin = "in" } }, { from = { node = "sw", pin = "4" }, to = { node = "p4", pin = "in" } }]
}
