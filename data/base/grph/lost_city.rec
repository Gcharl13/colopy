record grph.lost_city {
  name  = "Lost City Rumor"
  nodes = [{ id = "note", params = { text = "Lost-city rumor (spec/systems/exploration.md), rebuilt. Outcome = Roll(1,9); Hernando de Soto (ff.7) remaps a bad roll (5/6/8) to 3 (ruins) -- one Formula. A Seasoned Scout (UnitIsSeasonedScout of the entering unit) adds +2 to the treasure tier. Treasure amounts (Cibola, ruins, friendly-tribe gift) are each one Formula. Switch routes the 9 outcomes incl. the Fountain of Youth (8 immigrants)." }, type = "Comment", x = 20, y = -110 }, { id = "trig", params = { }, type = "OnLostCityEntered", x = 20, y = 40 }, { id = "roll", params = { max = 9, min = 1 }, type = "Roll", x = 20, y = 150 }, { id = "s", params = { unit = 0 }, type = "UnitIsSeasonedScout", x = 20, y = 230 }, { id = "neff", params = { expr = "(ff.7 && (a==5 || a==6 || a==8)) ? 3 : a" }, type = "Formula", x = 220, y = 150 }, { id = "cib", params = { expr = "((a+2)*10 + roll(1,20))*100" }, type = "Formula", x = 20, y = 330 }, { id = "mRuins", params = { expr = "(roll(1,8)+roll(1,8)+roll(1,8))*10*(a+2)/2" }, type = "Formula", x = 20, y = 400 }, { id = "mFriend", params = { expr = "(roll(1,10)+roll(1,10)+roll(1,10)+roll(1,10))*2" }, type = "Formula", x = 20, y = 470 }, { id = "sw", params = { }, type = "Switch", x = 420, y = 40 }, { id = "imm", params = { count = 8, power = "0", type = "Colonists" }, type = "GrantImmigrant", x = 620, y = 20 }, { id = "pop1", params = { choices = "Marvelous!", textKey = "@LOSTCITY1" }, type = "ShowPopup", x = 820, y = 20 }, { id = "gold2", params = { power = "0" }, type = "GrantGold", x = 620, y = 90 }, { id = "treas", params = { power = "0", type = "Treasure" }, type = "SpawnUnit", x = 760, y = 90 }, { id = "ferry", params = { graph = "treasure_transport" }, type = "FireEvent", x = 900, y = 90 }, { id = "pop2", params = { choices = "Glory!", textKey = "@LOSTCITY2" }, type = "ShowPopup", x = 1040, y = 90 }, { id = "gold3", params = { power = "0" }, type = "GrantGold", x = 620, y = 160 }, { id = "pop3", params = { choices = "A find!", textKey = "@LOSTCITY3" }, type = "ShowPopup", x = 820, y = 160 }, { id = "burial", params = { graph = "burial_mounds" }, type = "FireEvent", x = 620, y = 230 }, { id = "pop4", params = { choices = "Solemn.", textKey = "@BURIAL1" }, type = "ShowPopup", x = 820, y = 230 }, { id = "kill", params = { unit = 0 }, type = "DestroyUnit", x = 620, y = 300 }, { id = "pop5", params = { choices = "Alas.", textKey = "@LOSTCITY5" }, type = "ShowPopup", x = 820, y = 300 }, { id = "pop6", params = { choices = "Onward.", textKey = "@LOSTCITY6" }, type = "ShowPopup", x = 620, y = 370 }, { id = "gold7", params = { power = "0" }, type = "GrantGold", x = 620, y = 440 }, { id = "pop7", params = { choices = "Thank you.", textKey = "@LOSTCITY7" }, type = "ShowPopup", x = 820, y = 440 }, { id = "ten", params = { amount = 15 }, type = "ChangeNativeTension", x = 620, y = 510 }, { id = "pop8", params = { choices = "Uh oh.", textKey = "@LOSTCITY8" }, type = "ShowPopup", x = 820, y = 510 }, { id = "imm9", params = { count = 1, power = "0", type = "Colonists" }, type = "GrantImmigrant", x = 620, y = 580 }, { id = "popd", params = { choices = "Welcome.", textKey = "@LOSTCITY9" }, type = "ShowPopup", x = 820, y = 580 }, { id = "trb", params = { path = "@TRIBES[0].singular" }, type = "GetState", x = 620, y = 510 }, { id = "nat", params = { path = "@COUNTRY[0].name" }, type = "GetState", x = 620, y = 650 }]
  edges = [{ from = { node = "trb", pin = "value" }, to = { node = "pop8", pin = "str0" } }, { from = { node = "nat", pin = "value" }, to = { node = "popd", pin = "str0" } }, { from = { node = "roll", pin = "value" }, to = { node = "neff", pin = "a" } }, { from = { node = "s", pin = "value" }, to = { node = "cib", pin = "a" } }, { from = { node = "s", pin = "value" }, to = { node = "mRuins", pin = "a" } }, { from = { node = "trig", pin = "out" }, to = { node = "sw", pin = "in" } }, { from = { node = "neff", pin = "value" }, to = { node = "sw", pin = "value" } }, { from = { node = "sw", pin = "1" }, to = { node = "imm", pin = "in" } }, { from = { node = "imm", pin = "out" }, to = { node = "pop1", pin = "in" } }, { from = { node = "sw", pin = "2" }, to = { node = "gold2", pin = "in" } }, { from = { node = "cib", pin = "value" }, to = { node = "gold2", pin = "amount" } }, { from = { node = "gold2", pin = "out" }, to = { node = "treas", pin = "in" } }, { from = { node = "treas", pin = "out" }, to = { node = "ferry", pin = "in" } }, { from = { node = "ferry", pin = "out" }, to = { node = "pop2", pin = "in" } }, { from = { node = "cib", pin = "value" }, to = { node = "pop2", pin = "num1" } }, { from = { node = "sw", pin = "3" }, to = { node = "gold3", pin = "in" } }, { from = { node = "mRuins", pin = "value" }, to = { node = "gold3", pin = "amount" } }, { from = { node = "gold3", pin = "out" }, to = { node = "pop3", pin = "in" } }, { from = { node = "mRuins", pin = "value" }, to = { node = "pop3", pin = "num0" } }, { from = { node = "sw", pin = "4" }, to = { node = "burial", pin = "in" } }, { from = { node = "burial", pin = "out" }, to = { node = "pop4", pin = "in" } }, { from = { node = "sw", pin = "5" }, to = { node = "kill", pin = "in" } }, { from = { node = "kill", pin = "out" }, to = { node = "pop5", pin = "in" } }, { from = { node = "sw", pin = "6" }, to = { node = "pop6", pin = "in" } }, { from = { node = "sw", pin = "7" }, to = { node = "gold7", pin = "in" } }, { from = { node = "mFriend", pin = "value" }, to = { node = "gold7", pin = "amount" } }, { from = { node = "gold7", pin = "out" }, to = { node = "pop7", pin = "in" } }, { from = { node = "mFriend", pin = "value" }, to = { node = "pop7", pin = "num0" } }, { from = { node = "sw", pin = "8" }, to = { node = "ten", pin = "in" } }, { from = { node = "ten", pin = "out" }, to = { node = "pop8", pin = "in" } }, { from = { node = "sw", pin = "default" }, to = { node = "imm9", pin = "in" } }, { from = { node = "imm9", pin = "out" }, to = { node = "popd", pin = "in" } }]
