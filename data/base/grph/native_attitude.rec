record grph.native_attitude {
  name  = "Native Attitude"
  nodes = [{ id = "note", params = { text = "Native attitude (spec/systems/natives.md @0x048B62), rebuilt. The colonial-presence alarm bands into the 5 @ATTITUDE levels (Content/Uneasy/Restless/Angry/War); War (alarm>=128, modeled tension>=80) declares war. The band name is read live from the @ATTITUDE table." }, type = "Comment", x = 20, y = -90 }, { id = "trig", params = { }, type = "OnNativeAttitude", x = 20, y = 40 }, { id = "band", params = { expr = "(natives.tension>=20)+(natives.tension>=40)+(natives.tension>=60)+(natives.tension>=80)" }, type = "Formula", x = 20, y = 150 }, { id = "name", params = { column = "name", section = "@ATTITUDE" }, type = "TableLookup", x = 20, y = 230 }, { id = "atwar", params = { expr = "natives.tension >= 80" }, type = "Formula", x = 220, y = 150 }, { id = "br", params = { }, type = "Branch", x = 400, y = 40 }, { id = "attP", params = { body = "Our scouts report the natives' mood toward our colonies: %STRING0.", choices = "Noted.", title = "Tribal Relations" }, type = "ShowPopup", x = 600, y = 160 }, { id = "war", params = { a = "0", b = "3" }, type = "DeclareWar", x = 600, y = 40 }, { id = "warP", params = { body = "The natives have reached open %STRING0 -- braves take up arms against our colonies!", choices = "To the walls!", title = "War!", woodcut = "WDCUT13" }, type = "ShowPopup", x = 800, y = 40 }]
  edges = [{ from = { node = "band", pin = "value" }, to = { node = "name", pin = "index" } }, { from = { node = "trig", pin = "out" }, to = { node = "br", pin = "in" } }, { from = { node = "atwar", pin = "value" }, to = { node = "br", pin = "cond" } }, { from = { node = "br", pin = "false" }, to = { node = "attP", pin = "in" } }, { from = { node = "name", pin = "value" }, to = { node = "attP", pin = "str0" } }, { from = { node = "br", pin = "true" }, to = { node = "war", pin = "in" } }, { from = { node = "war", pin = "out" }, to = { node = "warP", pin = "in" } }, { from = { node = "name", pin = "value" }, to = { node = "warP", pin = "str0" } }]
}
