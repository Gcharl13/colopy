record grph.burial_mounds {
  name  = "Burial Mounds"
  nodes = [{ id = "note", params = { text = "Burial mounds (spec/systems/exploration.md), rebuilt. Roll(1,3) -> Switch: 1 @BURIAL1 (nothing/curse), 2 @BURIAL2 trinkets = 3d8*10 (%NUMBER0), else @BURIAL3 treasure = (1d8+10)*200 (%NUMBER1). Each formula is one node." }, type = "Comment", x = 20, y = -90 }, { id = "trig", params = { }, type = "OnTestFire", x = 20, y = 40 }, { id = "sub", params = { max = 3, min = 1 }, type = "Roll", x = 20, y = 150 }, { id = "sw", params = { }, type = "Switch", x = 220, y = 40 }, { id = "trink", params = { expr = "(roll(1,8)+roll(1,8)+roll(1,8))*10" }, type = "Formula", x = 20, y = 230 }, { id = "treasV", params = { expr = "(roll(1,8)+2*a+10)*200" }, type = "Formula", x = 20, y = 300 }, { id = "s", params = { unit = 0 }, type = "UnitIsSeasonedScout", x = 20, y = 370 }, { id = "p1", params = { choices = "Move on.", textKey = "@BURIAL1" }, type = "ShowPopup", x = 420, y = 20 }, { id = "g2", params = { power = "0" }, type = "GrantGold", x = 420, y = 120 }, { id = "p2", params = { choices = "Modest reward.", textKey = "@BURIAL2" }, type = "ShowPopup", x = 620, y = 120 }, { id = "g3", params = { power = "0" }, type = "GrantGold", x = 420, y = 240 }, { id = "p3", params = { choices = "A fortune!", textKey = "@BURIAL3" }, type = "ShowPopup", x = 620, y = 240 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "sw", pin = "in" } }, { from = { node = "sub", pin = "value" }, to = { node = "sw", pin = "value" } }, { from = { node = "sw", pin = "2" }, to = { node = "g2", pin = "in" } }, { from = { node = "trink", pin = "value" }, to = { node = "g2", pin = "amount" } }, { from = { node = "g2", pin = "out" }, to = { node = "p2", pin = "in" } }, { from = { node = "trink", pin = "value" }, to = { node = "p2", pin = "num0" } }, { from = { node = "sw", pin = "default" }, to = { node = "g3", pin = "in" } }, { from = { node = "treasV", pin = "value" }, to = { node = "g3", pin = "amount" } }, { from = { node = "g3", pin = "out" }, to = { node = "p3", pin = "in" } }, { from = { node = "treasV", pin = "value" }, to = { node = "p3", pin = "num1" } }, { from = { node = "sw", pin = "1" }, to = { node = "p1", pin = "in" } }, { from = { node = "s", pin = "value" }, to = { node = "treasV", pin = "a" } }]
}
