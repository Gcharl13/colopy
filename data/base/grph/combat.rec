record grph.combat {
  name  = "Combat Resolution"
  nodes = [{ id = "note", params = { text = "Land combat (spec/systems/combat.md func_05CA7E land decider + func_05B2C2 consequence applier). odds = ATK/(ATK+DEF); act-mode roll = random_int(1, ATK+DEF) <= ATK => attacker wins. DEF folds in the terrain/fort defense bonus ($TERRAIN Defensive: forests 2 / Hills 4 / Mountains 6, BYTE_VERIFIED). Loser walks down the demotion ladder (Soldiers->Colonist, Dragoons->Soldiers, ...) or is destroyed if it has no demotion. Demo resolves unit0 (attacker) attacking unit1 (defender); CombatOdds shows the win %." }, type = "Comment", x = 30, y = -130 }, { id = "trig", params = { }, type = "OnTestFire", x = 30, y = 40 }, { id = "atk", params = { path = "unit0.attack" }, type = "GetState", x = 30, y = 150 }, { id = "def0", params = { path = "unit1.defense" }, type = "GetState", x = 30, y = 230 }, { id = "tdef", params = { path = "unit1.terraindef" }, type = "GetState", x = 30, y = 310 }, { id = "def", params = { op = "+" }, type = "Math", x = 220, y = 270 }, { id = "total", params = { op = "+" }, type = "Math", x = 420, y = 200 }, { id = "odds", params = { }, type = "CombatOdds", x = 420, y = 40 }, { id = "c1", params = { value = 1 }, type = "Constant", x = 420, y = 300 }, { id = "roll", params = { }, type = "Roll", x = 600, y = 120 }, { id = "cmp", params = { op = "<=" }, type = "Compare", x = 780, y = 120 }, { id = "br", params = { }, type = "Branch", x = 960, y = 40 }, { id = "loseD", params = { unit = 1 }, type = "DemoteUnit", x = 1160, y = 40 }, { id = "loseA", params = { unit = 0 }, type = "DemoteUnit", x = 1160, y = 220 }, { id = "popW", params = { body = "The attacker carries the field! (a {%NUMBER0%%} win chance vs {unit1.defense}+{unit1.terraindef} terrain defense)", choices = "Huzzah!", title = "Victory!", woodcut = "WDCUT10" }, type = "ShowPopup", x = 1380, y = 40 }, { id = "popL", params = { body = "The attack is thrown back -- the attacker had only a {%NUMBER0%%} chance.", choices = "Regroup", title = "Defeat", woodcut = "WDCUT10" }, type = "ShowPopup", x = 1380, y = 220 }]
  edges = [{ from = { node = "def0", pin = "value" }, to = { node = "def", pin = "a" } }, { from = { node = "tdef", pin = "value" }, to = { node = "def", pin = "b" } }, { from = { node = "atk", pin = "value" }, to = { node = "total", pin = "a" } }, { from = { node = "def", pin = "value" }, to = { node = "total", pin = "b" } }, { from = { node = "atk", pin = "value" }, to = { node = "odds", pin = "atk" } }, { from = { node = "def", pin = "value" }, to = { node = "odds", pin = "def" } }, { from = { node = "c1", pin = "value" }, to = { node = "roll", pin = "min" } }, { from = { node = "total", pin = "value" }, to = { node = "roll", pin = "max" } }, { from = { node = "roll", pin = "value" }, to = { node = "cmp", pin = "a" } }, { from = { node = "atk", pin = "value" }, to = { node = "cmp", pin = "b" } }, { from = { node = "trig", pin = "out" }, to = { node = "br", pin = "in" } }, { from = { node = "cmp", pin = "value" }, to = { node = "br", pin = "cond" } }, { from = { node = "br", pin = "true" }, to = { node = "loseD", pin = "in" } }, { from = { node = "br", pin = "false" }, to = { node = "loseA", pin = "in" } }, { from = { node = "loseD", pin = "out" }, to = { node = "popW", pin = "in" } }, { from = { node = "odds", pin = "value" }, to = { node = "popW", pin = "num0" } }, { from = { node = "loseA", pin = "out" }, to = { node = "popL", pin = "in" } }, { from = { node = "odds", pin = "value" }, to = { node = "popL", pin = "num0" } }]
