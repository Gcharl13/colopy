record grph.scoring {
  name  = "Final Score"
  nodes = [{ id = "note", params = { text = "End-game scoring (spec/systems/scoring.md func_03A9C0), rebuilt. ScoreGame computes the live score; the difficulty multiplier diff+4 (+1 at diff>=3, +1 at diff>=4) = {4,5,6,8,10} is one Formula. %NUMBER0=score, %NUMBER1=mult." }, type = "Comment", x = 20, y = -80 }, { id = "trig", params = { }, type = "OnGameOver", x = 20, y = 40 }, { id = "score", params = { }, type = "ScoreGame", x = 200, y = 40 }, { id = "fscore", params = { path = "game.score" }, type = "GetState", x = 20, y = 150 }, { id = "mult", params = { expr = "game.difficulty + 4 + (game.difficulty>=3) + (game.difficulty>=4)" }, type = "Formula", x = 20, y = 220 }, { id = "pop", params = { body = "The age of colonization closes. Final score: {%NUMBER0} points at a difficulty multiplier of x{%NUMBER1}, with {ff.count} Founding Fathers and {colonies.population} colonists tallied.", choices = "So be it.", title = "The Hall of Fame" }, type = "ShowPopup", x = 400, y = 40 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "score", pin = "in" } }, { from = { node = "score", pin = "out" }, to = { node = "pop", pin = "in" } }, { from = { node = "fscore", pin = "value" }, to = { node = "pop", pin = "num0" } }, { from = { node = "mult", pin = "value" }, to = { node = "pop", pin = "num1" } }]
}
