record grph.training {
  name  = "Colonist Training"
  nodes = [{ id = "note", params = { text = "Colonist training (spec/systems/training.md). Three routes to expertise, here as a Switch on method: 0=NATIVE LEARNING (live in a village): a free colonist/indentured servant becomes a master of the local skill (@LEARNDONE); a petty criminal is too unskilled (@LEARNSLOW); an already-skilled colonist is refused (@LEARNMASTER). 1=SCHOOL: a master teaches an unskilled colonist over 4/6/8 turns by skill tier (Schoolhouse/College/University). 2=VETERAN: a combat winner is promoted (Washington auto-promotes; else random_int(1,S) <= winner strength). PromoteUnit applies the class change." }, type = "Comment", x = 20, y = -130 }, { id = "trig", params = { }, type = "OnTestFire", x = 20, y = 40 }, { id = "method", params = { value = 0 }, type = "Constant", x = 20, y = 160 }, { id = "sw", params = { }, type = "Switch", x = 220, y = 40 }, { id = "pupil", params = { value = 1 }, type = "Constant", x = 20, y = 260 }, { id = "psw", params = { }, type = "Switch", x = 420, y = 260 }, { id = "lcrim", params = { choices = "We shall return.", textKey = "@LEARNCRIMINAL" }, type = "ShowPopup", x = 640, y = 360 }, { id = "learn", params = { unit = 0 }, type = "PromoteUnit", x = 640, y = 180 }, { id = "ldone", params = { choices = "We are grateful.", textKey = "@LEARNDONE" }, type = "ShowPopup", x = 840, y = 180 }, { id = "lmaster", params = { choices = "Of course.", textKey = "@LEARNMASTER" }, type = "ShowPopup", x = 640, y = 460 }, { id = "school", params = { unit = 0 }, type = "PromoteUnit", x = 420, y = 40 }, { id = "pschool", params = { body = "A master colonist has taught an apprentice his trade (4/6/8 turns by tier in the Schoolhouse/College/University).", choices = "Well taught.", title = "Schooling Complete" }, type = "ShowPopup", x = 620, y = 40 }, { id = "vet", params = { to = "Veteran Soldiers", unit = 0 }, type = "PromoteUnit", x = 420, y = 120 }, { id = "pvet", params = { body = "Your soldiers distinguish themselves in battle and are promoted to Veterans (Washington auto-promotes; otherwise random_int(1,strength) <= the winner's strength).", choices = "Huzzah!", title = "Veteran Status" }, type = "ShowPopup", x = 620, y = 120 }, { id = "lcrim_tribe", params = { path = "@TRIBES[0].singular" }, type = "GetState", x = 440, y = 360 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "sw", pin = "in" } }, { from = { node = "method", pin = "value" }, to = { node = "sw", pin = "value" } }, { from = { node = "sw", pin = "default" }, to = { node = "psw", pin = "in" } }, { from = { node = "pupil", pin = "value" }, to = { node = "psw", pin = "value" } }, { from = { node = "psw", pin = "default" }, to = { node = "lcrim", pin = "in" } }, { from = { node = "psw", pin = "1" }, to = { node = "learn", pin = "in" } }, { from = { node = "learn", pin = "out" }, to = { node = "ldone", pin = "in" } }, { from = { node = "psw", pin = "2" }, to = { node = "lmaster", pin = "in" } }, { from = { node = "sw", pin = "1" }, to = { node = "school", pin = "in" } }, { from = { node = "school", pin = "out" }, to = { node = "pschool", pin = "in" } }, { from = { node = "sw", pin = "2" }, to = { node = "vet", pin = "in" } }, { from = { node = "vet", pin = "out" }, to = { node = "pvet", pin = "in" } }, { from = { node = "lcrim_tribe", pin = "value" }, to = { node = "lcrim", pin = "str0" } }]
