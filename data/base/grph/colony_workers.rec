record grph.colony_workers {
  name  = "Colony Workers -> Stockpile"
  nodes = [{ id = "note", params = { text = "The worker/stockpile side of production (spec/systems/colony.md §3). Each AssignWorker puts a colonist on a terrain tile (a raw good, yield read LIVE from @UNFORESTED/@FORESTED/@OTHER by terrain id) or in a building (Hammers/Crosses/Bells). ColonyProduce then runs them all: tile yields pass through the tory/expert adjust, building workers use the base rate, and the result accrues into colony0.stockpile.<good> (capped by the warehouse) plus net food/bells/hammers/crosses. Edit a terrain's yield in the Tables tab and the numbers here change with no code." }, type = "Comment", x = 20, y = -120 }, { id = "trig", params = { }, type = "OnColonyProduction", x = 20, y = 60 }, { id = "farmer", params = { colony = 0, expert = "0", good = "Food", terrain = 2 }, type = "AssignWorker", x = 220, y = 60 }, { id = "planter", params = { colony = 0, expert = "1", good = "Cotton", terrain = 3 }, type = "AssignWorker", x = 420, y = 60 }, { id = "statesman", params = { colony = 0, expert = "0", good = "Bells", terrain = 0 }, type = "AssignWorker", x = 620, y = 60 }, { id = "produce", params = { colony = 0 }, type = "ColonyProduce", x = 820, y = 60 }, { id = "export", params = { colony = 0 }, type = "ExportOverflow", x = 1020, y = 60 }, { id = "rep", params = { body = "{colony0.workers} colonists at work. Warehouse: Cotton {colony0.stockpile.3}. Net food {colony0.food}, bells {colony0.bells}.", choices = "Onward.", title = "Colony Report" }, type = "ShowPopup", x = 1240, y = 60 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "farmer", pin = "in" } }, { from = { node = "farmer", pin = "out" }, to = { node = "planter", pin = "in" } }, { from = { node = "planter", pin = "out" }, to = { node = "statesman", pin = "in" } }, { from = { node = "statesman", pin = "out" }, to = { node = "produce", pin = "in" } }, { from = { node = "produce", pin = "out" }, to = { node = "export", pin = "in" } }, { from = { node = "export", pin = "out" }, to = { node = "rep", pin = "in" } }]
}
