record grph.tory_status {
  name  = "Tory / Rebel Status"
  nodes = [{ id = "note", params = { text = "Tory/rebel status (spec/systems/revolution.md). bucket = (sol>=50)+(sol>=100): 2 unanimous, 1 majority, else Tory majority. One Formula + Switch over the real @REBEL*/@TORYMAJORITY messages." }, type = "Comment", x = 20, y = -80 }, { id = "trig", params = { }, type = "OnSoLThreshold", x = 20, y = 40 }, { id = "bucket", params = { expr = "(revolution.sol>=50)+(revolution.sol>=100)" }, type = "Formula", x = 20, y = 150 }, { id = "sw", params = { }, type = "Switch", x = 220, y = 40 }, { id = "popU", params = { choices = "Liberty!", textKey = "@REBELUNANIMOUS" }, type = "ShowPopup", x = 420, y = 20 }, { id = "popM", params = { choices = "Onward.", textKey = "@REBELMAJORITY" }, type = "ShowPopup", x = 420, y = 90 }, { id = "popT", params = { choices = "Hmph.", textKey = "@TORYMAJORITY" }, type = "ShowPopup", x = 420, y = 160 }, { id = "gsM_num0", params = { path = "revolution.sol" }, type = "GetState", x = 620, y = 70 }, { id = "gsM_str0", params = { path = "@COLONYNAME[0].name" }, type = "GetState", x = 620, y = 110 }, { id = "gsM_str1", params = { path = "@COUNTRY[0].name" }, type = "GetState", x = 620, y = 150 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "sw", pin = "in" } }, { from = { node = "bucket", pin = "value" }, to = { node = "sw", pin = "value" } }, { from = { node = "sw", pin = "2" }, to = { node = "popU", pin = "in" } }, { from = { node = "sw", pin = "1" }, to = { node = "popM", pin = "in" } }, { from = { node = "sw", pin = "default" }, to = { node = "popT", pin = "in" } }, { from = { node = "gsM_num0", pin = "value" }, to = { node = "popM", pin = "num0" } }, { from = { node = "gsM_str0", pin = "value" }, to = { node = "popM", pin = "str0" } }, { from = { node = "gsM_str1", pin = "value" }, to = { node = "popM", pin = "str1" } }]
}
