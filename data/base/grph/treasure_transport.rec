record grph.treasure_transport {
  name  = "Treasure Transport"
  nodes = [{ id = "note", params = { text = "Treasure transport to Europe -- the King's cut (spec/systems/natives.md func_05C878). @KINGGALLEON2 is an OFFER: with no galleon of your own, the Crown proposes to ship the treasure and take a cut. Cut% = Hernan Cortes (ff.10) ? tax : min(max(5*diff+50, 2*tax), 90). You KEEP treasure - treasure*cut/100 -- but only if you accept; declining ships nothing and grants nothing (the treasure stays in the New World). One Formula computes the kept amount; the grant is gated behind the accept choice. (treasure proxied by the treasury here.)" }, type = "Comment", x = 20, y = -110 }, { id = "trig", params = { }, type = "OnTestFire", x = 20, y = 40 }, { id = "keep", params = { expr = "power0.gold - power0.gold * (ff.10 ? power0.tax : min(max(5*game.difficulty+50, 2*power0.tax), 90)) / 100" }, type = "Formula", x = 20, y = 170 }, { id = "pop", params = { choices = "Let the Crown ship it,Keep it in the New World", speaker = "King", textKey = "@KINGGALLEON2" }, type = "ShowPopup", x = 240, y = 40 }, { id = "grant", params = { power = "0" }, type = "GrantGold", x = 470, y = 10 }, { id = "done", params = { body = "The Crown's galleon delivers your treasure to Europe, less its cut. You now hold {power0.gold} gold.", choices = "Very well.", title = "Treasure Delivered" }, type = "ShowPopup", x = 690, y = 10 }, { id = "kept", params = { body = "You keep the treasure in the New World, awaiting a galleon of your own to ship it.", choices = "As you wish.", title = "Treasure Kept" }, type = "ShowPopup", x = 470, y = 110 }]
  edges = [{ from = { node = "trig", pin = "out" }, to = { node = "pop", pin = "in" } }, { from = { node = "pop", pin = "Let the Crown ship it" }, to = { node = "grant", pin = "in" } }, { from = { node = "keep", pin = "value" }, to = { node = "grant", pin = "amount" } }, { from = { node = "grant", pin = "out" }, to = { node = "done", pin = "in" } }, { from = { node = "pop", pin = "Keep it in the New World" }, to = { node = "kept", pin = "in" } }]
}
