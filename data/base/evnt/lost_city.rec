record evnt.lost_city {
  name     = "Lost City Rumor"
  vars     = [{ args = { a = "$s" }, do = "Formula", expr = "((a+2)*10 + roll(1,20))*100", id = "cib" }, { do = "Formula", expr = "(roll(1,10)+roll(1,10)+roll(1,10)+roll(1,10))*2", id = "mFriend" }, { args = { a = "$s" }, do = "Formula", expr = "(roll(1,8)+roll(1,8)+roll(1,8))*10*(a+2)/2", id = "mRuins" }, { do = "GetState", id = "nat", path = "@COUNTRY[0].name" }, { args = { a = "$roll" }, do = "Formula", expr = "(ff.7 && (a==5 || a==6 || a==8)) ? 3 : a", id = "neff" }, { do = "Roll", id = "roll", max = 9, min = 1 }, { do = "UnitIsSeasonedScout", id = "s", unit = 0 }, { do = "GetState", id = "trb", path = "@TRIBES[0].singular" }]
  steps    = [{ do = "OnLostCityEntered" }, { args = { value = "$neff" }, branches = [{ pin = "1", steps = [{ count = 8, do = "GrantImmigrant", power = "0", type = "Colonists" }, { choices = "Marvelous!", do = "ShowPopup", textKey = "@LOSTCITY1" }] }, { pin = "2", steps = [{ args = { amount = "$cib" }, do = "GrantGold", power = "0" }, { do = "SpawnUnit", power = "0", type = "Treasure" }, { do = "FireEvent", graph = "treasure_transport" }, { args = { num1 = "$cib" }, choices = "Glory!", do = "ShowPopup", textKey = "@LOSTCITY2" }] }, { pin = "3", steps = [{ args = { amount = "$mRuins" }, do = "GrantGold", power = "0" }, { args = { num0 = "$mRuins" }, choices = "A find!", do = "ShowPopup", textKey = "@LOSTCITY3" }] }, { pin = "4", steps = [{ do = "FireEvent", graph = "burial_mounds" }, { choices = "Solemn.", do = "ShowPopup", textKey = "@BURIAL1" }] }, { pin = "5", steps = [{ do = "DestroyUnit", unit = 0 }, { choices = "Alas.", do = "ShowPopup", textKey = "@LOSTCITY5" }] }, { pin = "6", steps = [{ choices = "Onward.", do = "ShowPopup", textKey = "@LOSTCITY6" }] }, { pin = "7", steps = [{ args = { amount = "$mFriend" }, do = "GrantGold", power = "0" }, { args = { num0 = "$mFriend" }, choices = "Thank you.", do = "ShowPopup", textKey = "@LOSTCITY7" }] }, { pin = "8", steps = [{ amount = 15, do = "ChangeNativeTension" }, { args = { str0 = "$trb" }, choices = "Uh oh.", do = "ShowPopup", textKey = "@LOSTCITY8" }] }, { pin = "default", steps = [{ count = 1, do = "GrantImmigrant", power = "0", type = "Colonists" }, { args = { str0 = "$nat" }, choices = "Welcome.", do = "ShowPopup", textKey = "@LOSTCITY9" }] }], do = "Switch" }]
  comments = [{ text = "Lost-city rumor (spec/systems/exploration.md), rebuilt. Outcome = Roll(1,9); Hernando de Soto (ff.7) remaps a bad roll (5/6/8) to 3 (ruins) -- one Formula. A Seasoned Scout (UnitIsSeasonedScout of the entering unit) adds +2 to the treasure tier. Treasure amounts (Cibola, ruins, friendly-tribe gift) are each one Formula. Switch routes the 9 outcomes incl. the Fountain of Youth (8 immigrants).", x = 20, y = -110 }]
}
