record evnt.colony_workers {
  name     = "Colony Workers -> Stockpile"
  steps    = [{ do = "OnColonyProduction" }, { colony = 0, do = "AssignWorker", expert = "0", good = "Food", terrain = 2 }, { colony = 0, do = "AssignWorker", expert = "1", good = "Cotton", terrain = 3 }, { colony = 0, do = "AssignWorker", expert = "0", good = "Bells", terrain = 0 }, { colony = 0, do = "ColonyProduce" }, { colony = 0, do = "ExportOverflow" }, { body = "{colony0.workers} colonists at work. Warehouse: Cotton {colony0.stockpile.3}. Net food {colony0.food}, bells {colony0.bells}.", choices = "Onward.", do = "ShowPopup", title = "Colony Report" }]
  comments = [{ text = "The worker/stockpile side of production (spec/systems/colony.md §3). Each AssignWorker puts a colonist on a terrain tile (a raw good, yield read LIVE from @UNFORESTED/@FORESTED/@OTHER by terrain id) or in a building (Hammers/Crosses/Bells). ColonyProduce then runs them all: tile yields pass through the tory/expert adjust, building workers use the base rate, and the result accrues into colony0.stockpile.<good> (capped by the warehouse) plus net food/bells/hammers/crosses. Edit a terrain's yield in the Tables tab and the numbers here change with no code.", x = 20, y = -120 }]
}
