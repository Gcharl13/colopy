record evnt.founding_father {
  name     = "Founding Father Offer"
  vars     = [{ do = "Formula", expr = "2 + congress.era_band", id = "bandcol" }, { args = { a = "$w0", b = "$w1", c = "$w2", d = "$w3", e = "$w4" }, do = "Formula", expr = "roll(1, a+b+c+d+e)", id = "budget" }, { do = "GetState", id = "cost", path = "congress.cost" }, { args = { index = "$pick" }, do = "PickText", id = "feff", options = "enables factory-tier buildings,speeds the Atlantic crossing to a single turn,auto-promotes your combat winners,doubles your liberty-bell output,raises colony crosses output by half" }, { args = { index = "$pick" }, do = "PickNumber", id = "fid", values = "0,5,11,15,21" }, { args = { index = "$fid" }, column = "name", do = "TableLookup", id = "fname", section = "@FATHERS" }, { do = "Formula", expr = "congress.bells >= congress.cost", id = "gate" }, { do = "GetState", id = "natadj", path = "@NATIONALITY[0].name" }, { args = { a = "$w0", b = "$w1", c = "$w2", d = "$w3", f = "$budget" }, do = "Formula", expr = "(f>a)+(f>a+b)+(f>a+b+c)+(f>a+b+c+d)", id = "pick" }, { args = { col = "$bandcol", index = "$w0r" }, column = "2", do = "TableLookup", id = "w0", section = "@FATHERS" }, { do = "Constant", id = "w0r", value = 0 }, { args = { col = "$bandcol", index = "$w1r" }, column = "2", do = "TableLookup", id = "w1", section = "@FATHERS" }, { do = "Constant", id = "w1r", value = 5 }, { args = { col = "$bandcol", index = "$w2r" }, column = "2", do = "TableLookup", id = "w2", section = "@FATHERS" }, { do = "Constant", id = "w2r", value = 11 }, { args = { col = "$bandcol", index = "$w3r" }, column = "2", do = "TableLookup", id = "w3", section = "@FATHERS" }, { do = "Constant", id = "w3r", value = 15 }, { args = { col = "$bandcol", index = "$w4r" }, column = "2", do = "TableLookup", id = "w4", section = "@FATHERS" }, { do = "Constant", id = "w4r", value = 21 }]
  steps    = [{ do = "OnTurnStart" }, { args = { cond = "$gate" }, branches = [{ pin = "true", steps = [{ args = { num0 = "$cost", str0 = "$fname", str1 = "$feff" }, body = "The Continental Congress can appoint %STRING0, who %STRING1, for %NUMBER0 liberty bells. Shall we welcome them?", branches = [{ pin = "Welcome", steps = [{ args = { father = "$fid" }, do = "GiveFoundingFather" }, { args = { str0 = "$fname", str1 = "$natadj" }, choices = "Huzzah!", do = "ShowPopup", textKey = "@FREEDOM" }] }], choices = "Welcome,Decline", do = "ShowPopup", speaker = "Statesman", title = "The Continental Congress" }] }], do = "Branch" }]
  comments = [{ text = "Continental Congress (spec/systems/founding_fathers.md), rebuilt table-driven. Trigger: congress.bells >= congress.cost (the byte-verified bell curve). Selection = era-weighted random over un-owned fathers; the 3 @FATHERS weight columns ARE the era bands, read live by TableLookup with col = 2 + era_band -- edit a father's weights in the Tables tab and the offer odds change. Modeled over one representative father per category (rows 0/5/11/15/21).", x = 20, y = -120 }]
}
