record evnt.terrain_improvement {
  name     = "Terrain Improvement"
  vars     = [{ do = "Constant", id = "c10", value = 10 }, { do = "GetState", id = "gsColony", path = "@COLONYNAME[0].name" }, { args = { a = "$lumber", b = "$c10" }, do = "Math", id = "lum", op = "*" }, { count = 2, do = "Dice", id = "lumber", sides = 5 }, { do = "Constant", id = "order", value = 0 }]
  steps    = [{ do = "OnPlayerCommand" }, { args = { value = "$order" }, branches = [{ pin = "1", steps = [{ body = "Pioneers plow the fields -- crop yield rises by 1 on this tile (tile bit 0x40 set). 20 tools spent.", choices = "Good.", do = "ShowPopup", title = "Fields Plowed" }] }, { pin = "2", steps = [{ body = "Pioneers complete a road -- movement here drops to 1/3 and ore/fur/timber ease out (tile bit 0x08 set). 20 tools spent.", choices = "Good.", do = "ShowPopup", title = "Road Built" }] }, { pin = "default", steps = [{ args = { num0 = "$lum", str0 = "$gsColony" }, choices = "Onward.", do = "ShowPopup", textKey = "@CLEARCUT" }] }], do = "Switch" }]
  comments = [{ text = "Pioneer terrain improvement (spec/systems/terrain_improvement.md func_040656 clear/plow, func_0409D6 road). A Pioneer holds the order for several turns: work-counter (+0x16) increments each turn until it reaches the per-terrain threshold (clear/plow = terrain_table+2, road = terrain_table), HALVED for a Hardy Pioneer. On completion 20 tools are spent and the tile byte changes: CLEAR forest = terrain id - 8 (+ lumber to the colony), PLOW = set bit 0x40 (+1 crop), ROAD = set bit 0x08 (movement). Switch on the order; FLAGGED: per-terrain threshold values are the @TERRAIN stride-16 table (here a Constant=4).", x = 20, y = -130 }]
}
