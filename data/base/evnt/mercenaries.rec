record evnt.mercenaries {
  name     = "Mercenary Offer"
  vars     = [{ do = "GetState", id = "forceF", path = "game.merc_force" }, { do = "GetState", id = "nationF", path = "@NATIONALITY[0].name" }, { do = "Formula", expr = "revolution.declared ? (roll(1,3)==1) : (roll(1,21)==1)", id = "odds" }, { do = "GetState", id = "priceF", path = "game.merc_price" }, { do = "Formula", expr = "revolution.declared", id = "wdecl" }]
  steps    = [{ do = "OnTurnStart" }, { args = { cond = "$odds" }, branches = [{ pin = "true", steps = [{ branches = [{ pin = "offer", steps = [{ args = { num0 = "$priceF", str0 = "$nationF", str1 = "$forceF" }, branches = [{ pin = "choice1", steps = [{ args = { cond = "$wdecl" }, branches = [{ pin = "false", steps = [{ do = "HireMercenaries", kind = "Peacetime", power = "0" }, { choices = "Welcome.", do = "ShowPopup", textKey = "@MERCS" }] }, { pin = "true", steps = [{ do = "HireMercenaries", kind = "Wartime", power = "0" }, { choices = "Welcome.", do = "ShowPopup", textKey = "@MERCS" }] }], do = "Branch" }] }], choices = "No thank you.,Pay", do = "ShowPopup", speaker = "King", textKey = "@MERCENARIES" }] }], do = "MercenaryQuote" }] }], do = "Branch" }]
  comments = [{ text = "Mercenary offer (spec/systems/mercenary.md func_03E442): odds wartime 1-in-3 vs peacetime 1-in-21; the counts, force description and BYTE-VERIFIED price ((diff+K)*2+roll(0,6))*100 per unit are pre-rolled by MercenaryQuote BEFORE the @MERCENARIES dialog so %NUMBER0/%STRING1 bind the real offer (@0x03E4E8 odds; quote/affordability @0x03E5FD; first-call prime bit @0x03E4BC). The dialog's choice texts live in the message tail (No thank you. / Pay); choice 1 hires at exactly the quoted price.", x = 40, y = 40 }]
}
