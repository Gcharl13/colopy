record evnt.native_trade {
  name     = "Native Settlement Trade"
  vars     = [{ do = "GetState", id = "gname", path = "@CARGO[12].name" }, { args = { a = "$pct" }, do = "Formula", expr = "@CARGO[12].price_start1 * 100 * a / 100", id = "offer" }, { args = { a = "$offer" }, do = "Formula", expr = "a * 110 / 100", id = "offer2" }, { do = "Formula", expr = "min(max(5*game.difficulty + 50, 2*power0.tax), 90)", id = "pct" }, { do = "PickText", id = "qty", options = "100 units of" }]
  steps    = [{ do = "OnTestFire" }, { args = { num0 = "$offer", num1 = "$offer2", str0 = "$qty", str1 = "$gname" }, branches = [{ pin = "Accept", steps = [{ args = { amount = "$offer" }, do = "GrantGold", power = "0" }, { amount = -4, do = "ChangeNativeTension" }] }], choices = "Accept,Haggle,Decline", do = "ShowPopup", speaker = "Native Chief", textKey = "@TRADE0" }]
  comments = [{ text = "Trading at a native settlement (spec/systems/natives.md). The price the natives pay is a PERCENT of the European value: native_trade_price = min( max(5*difficulty + 50, 2*tax%), 90 ) -- it rises with difficulty and with your own tax rate, capped at 90% (BYTE_VERIFIED sim/natives.cpp). The offer for 100 units of a good is price.<good> * 100 * pct/100. Accepting pays gold and eases tension; every term is a live binding or an inline constant in a Formula -- no magic-number nodes. (Tribute demands use the sibling formula tribute_gold = clamp(demand, 10, min(3*wealth+10, 100)).)", x = 20, y = -150 }]
}
