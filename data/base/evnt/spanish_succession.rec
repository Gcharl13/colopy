record evnt.spanish_succession {
  name     = "War of Spanish Succession"
  vars     = [{ do = "GetState", id = "gs_benef", path = "@NATIONALITY[0].name" }, { do = "GetState", id = "gs_ceder", path = "@NATIONALITY[2].name" }, { do = "PickText", id = "pt_cede", options = "its New World possessions" }, { do = "StrongestPower", id = "strong", metric = "strength" }, { do = "WeakestPower", id = "weak", metric = "strength" }]
  steps    = [{ do = "OnSpanishSuccession" }, { args = { from = "$weak", to = "$strong" }, do = "TransferColonies" }, { args = { str0 = "$gs_ceder", str1 = "$pt_cede", str2 = "$gs_benef" }, choices = "Continue", do = "ShowPopup", speaker = "King", textKey = "@SUCCESSION" }]
  comments = [{ text = "Victim selection (spec: rank by 3*[0x9418]+2*[0x9298]+1*[0x9410]). Now reads REAL editable per-power fields: power<N>.strength = 3*mil_strength + 2*colony_count + 1*econ_strength. colony_count is live (the decoded 0x9298); mil_strength/econ_strength are editable in the State Inspector (proxy the undecoded 0x9418/0x9410 arrays). WeakestPower cedes to StrongestPower. NOTE: @SUCCESSION also has a %STRING3 slot, but the engine only fills str0/str1/str2 and num0/num1 on ShowPopup -- there is no str3, so %STRING3 is left unsupported and unfilled.", x = 20, y = -90 }]
}
