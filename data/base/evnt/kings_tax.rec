record evnt.kings_tax {
  name     = "King's Tax Demand"
  vars     = [{ args = { a = "$sev" }, do = "Formula", expr = "(a>=650) + (a>=950) + (a>=1100)", id = "bucket" }, { do = "Formula", expr = "(game.difficulty - game.difficulty%2)*2 + 4", id = "delta" }, { do = "Formula", expr = "game.turn >= 30 && (game.turn % (game.year>=1750 ? 9 : game.year>=1700 ? 12 : game.year>=1600 ? 15 : 18)) == 0 && power0.tax <= 85 && (power0.tax > ((game.difficulty - game.difficulty%2)*2 + 4)*(floor(game.turn/400)+1) || roll(1, game.difficulty+1) != 1)", id = "due" }, { args = { a = "$delta" }, do = "Formula", expr = "min(power0.tax + a, 75)", id = "newTax" }, { do = "Formula", expr = "roll(1,1000) + (2*revolution.sol - power0.tax)*5 + power0.gold/100 + power0.econ_strength + floor(game.turn/30)", id = "sev" }]
  steps    = [{ do = "OnTurnStart" }, { args = { cond = "$due" }, branches = [{ pin = "true", steps = [{ args = { value = "$bucket" }, branches = [{ pin = "1", steps = [{ args = { num0 = "$delta", num1 = "$newTax" }, branches = [{ pin = "Hold a Party", steps = [{ do = "AddBoycott", good = "Tobacco" }, { choices = "No taxation without representation!", do = "ShowPopup", textKey = "@TEAPARTY" }] }, { pin = "Kiss the royal pinky ring", steps = [{ args = { value = "$newTax" }, do = "SetTax", power = "0" }] }], choices = "Kiss the royal pinky ring,Hold a Party", do = "ShowPopup", speaker = "King", textKey = "@KINGWAR" }] }, { pin = "2", steps = [{ args = { num0 = "$delta", num1 = "$newTax" }, branches = [{ pin = "Hold a Party", steps = [{ do = "AddBoycott", good = "Tobacco" }, { choices = "No taxation without representation!", do = "ShowPopup", textKey = "@TEAPARTY" }] }, { pin = "Kiss the royal pinky ring", steps = [{ args = { value = "$newTax" }, do = "SetTax", power = "0" }] }], choices = "Kiss the royal pinky ring,Hold a Party", do = "ShowPopup", speaker = "King", textKey = "@KINGNAVACT" }] }, { pin = "3", steps = [{ args = { num0 = "$delta", num1 = "$newTax" }, branches = [{ pin = "Hold a Party", steps = [{ do = "AddBoycott", good = "Tobacco" }, { choices = "No taxation without representation!", do = "ShowPopup", textKey = "@TEAPARTY" }] }, { pin = "Kiss the royal pinky ring", steps = [{ args = { value = "$newTax" }, do = "SetTax", power = "0" }] }], choices = "Kiss the royal pinky ring,Hold a Party", do = "ShowPopup", speaker = "King", textKey = "@KINGSTAMPACT" }] }, { pin = "default", steps = [{ args = { num0 = "$delta", num1 = "$newTax" }, branches = [{ pin = "Hold a Party", steps = [{ do = "AddBoycott", good = "Tobacco" }, { choices = "No taxation without representation!", do = "ShowPopup", textKey = "@TEAPARTY" }] }, { pin = "Kiss the royal pinky ring", steps = [{ args = { value = "$newTax" }, do = "SetTax", power = "0" }] }], choices = "Kiss the royal pinky ring,Hold a Party", do = "ShowPopup", speaker = "King", textKey = "@KINGWIFE" }] }], do = "Switch" }] }], do = "Branch" }]
  comments = [{ text = "King's tax demand (spec/systems/king.md func_036138/034AE0/034318), rebuilt with Formula + Notify. Cadence, raise, severity and pretext bucket are each ONE Formula node referencing live variables; the four pretexts are the real @KING* messages with %NUMBER0=raise, %NUMBER1=new rate. AUDIT 2026-07-02: func_034AE0's difficulty roll gate added (tax <= candidate -> random_int(1,diff+1)==1 skips the raise, @034B25..034B30) with candidate = ((diff&0xFE)<<1 + 4)*(turn/400 + 1) (@034AEE..034B0D). The @034B10 gate reads literally as 'return when candidate+5 >= tax', which would prevent any raise from tax 0 and contradicts this cadence path -- NOT wired; flagged as a spec reconciliation question in king.md.", x = 20, y = -90 }]
}
