record evnt.immigration {
  name     = "Religious Immigration"
  vars     = [{ do = "Formula", expr = "roll(1,15) <= (game.difficulty+18)/2 ? roll(0,2) : (ff.20 ? 7 : 6)", id = "cls" }, { args = { index = "$cls" }, column = "transport_cost", do = "TableLookup", id = "cost", section = "@CLASS" }, { do = "Formula", expr = "power0.crosses > min((colonies.population + power0.units)*2 + 8, 4000)*(8-game.difficulty)/8*2/3", id = "gate" }, { args = { index = "$cls" }, column = "name", do = "TableLookup", id = "name", section = "@CLASS" }, { args = { a = "$cost" }, do = "Formula", expr = "-a", id = "neg" }]
  steps    = [{ do = "OnTurnStart" }, { args = { cond = "$gate" }, branches = [{ pin = "true", steps = [{ do = "SpawnUnit", power = "0", type = "Colonists" }, { args = { str1 = "$name" }, branches = [{ pin = "Visit the docks", steps = [{ args = { num0 = "$cost" }, branches = [{ pin = "Pay their passage", steps = [{ args = { amount = "$neg" }, do = "GrantGold", power = "0" }, { body = "The colonist boards for the New World.", choices = "Godspeed.", do = "ShowPopup", title = "Passage Paid" }] }], choices = "Pay their passage,Leave them waiting", do = "ShowPopup", speaker = "Recruiter", textKey = "@RECRUIT" }] }], choices = "Visit the docks", do = "ShowPopup", textKey = "@UNREST", woodcut = "WDCUT04" }] }], do = "Branch" }]
  comments = [{ text = "Religious immigration (spec/systems/immigration.md), rebuilt with Formula + TableLookup. Trigger: the accumulated crosses (power0.crosses) pass the byte-verified crosses_threshold -- base a = total colonists + units, then min(a*2+8, 4000), scaled by difficulty (8-diff)/8 and England x2/3; the spawn fires when crosses STRICTLY exceed it (jg). Arriving class = difficulty-weighted refill roll: roll(1,15) <= (diff+18)/2 picks a low tier (criminals/servants/farmers, @CLASS rows 0-2) else high tier (Trained Mercenaries 6, or Educated Elite 7 with William Brewster ff.20). Class name + recruit cost read live from @CLASS by index.", x = 20, y = -90 }]
}
