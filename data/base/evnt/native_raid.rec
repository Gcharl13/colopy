record evnt.native_raid {
  name     = "Native Raid on Colony"
  vars     = [{ do = "Formula", expr = "(roll(1,6)+roll(1,6))*25", id = "amt" }, { do = "Formula", expr = "natives.tension >= 75", id = "gate" }, { args = { a = "$amt" }, do = "Formula", expr = "-a", id = "neg" }, { do = "Roll", id = "roll", max = 4, min = 0 }]
  steps    = [{ do = "OnTurnStart" }, { args = { cond = "$gate" }, branches = [{ pin = "true", steps = [{ args = { value = "$roll" }, branches = [{ pin = "1", steps = [{ choices = "Outrage!", do = "ShowPopup", textKey = "@RAIDSTORES", woodcut = "WDCUT12" }] }, { pin = "2", steps = [{ choices = "Vengeance!", do = "ShowPopup", textKey = "@RAIDWREAK", woodcut = "WDCUT12" }] }, { pin = "3", steps = [{ args = { amount = "$neg" }, do = "GrantGold", power = "0" }, { args = { num0 = "$amt" }, choices = "Enraged!", do = "ShowPopup", textKey = "@RAIDGOLD", woodcut = "WDCUT12" }] }, { pin = "4", steps = [{ choices = "Rebuild", do = "ShowPopup", textKey = "@RAIDBURN", woodcut = "WDCUT12" }] }, { pin = "default", steps = [{ choices = "Jubilant!", do = "ShowPopup", textKey = "@RAIDNOTHING" }] }], do = "Switch" }] }], do = "Branch" }]
  comments = [{ text = "Native raid (spec/systems/natives.md), rebuilt. Gate: alarm >= 128 (tension>=75). Outcome = Roll(0,4) -> Switch: 0/default nothing, 1 stores, 2 wreak, 3 gold, 4 burn. Plundered gold = 2d6*25 (one Formula), wired to @RAIDGOLD %NUMBER0 and granted (negated).", x = 20, y = -90 }]
}
