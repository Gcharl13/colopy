record evnt.training {
  name     = "Colonist Training"
  vars     = [{ do = "GetState", id = "lcrim_tribe", path = "@TRIBES[0].singular" }, { do = "Constant", id = "method", value = 0 }, { do = "Constant", id = "pupil", value = 1 }]
  steps    = [{ do = "OnTestFire" }, { args = { value = "$method" }, branches = [{ pin = "1", steps = [{ do = "PromoteUnit", unit = 0 }, { body = "A master colonist has taught an apprentice his trade (4/6/8 turns by tier in the Schoolhouse/College/University).", choices = "Well taught.", do = "ShowPopup", title = "Schooling Complete" }] }, { pin = "2", steps = [{ do = "PromoteUnit", to = "Veteran Soldiers", unit = 0 }, { body = "Your soldiers distinguish themselves in battle and are promoted to Veterans (Washington auto-promotes; otherwise random_int(1,strength) <= the winner's strength).", choices = "Huzzah!", do = "ShowPopup", title = "Veteran Status" }] }, { pin = "default", steps = [{ args = { value = "$pupil" }, branches = [{ pin = "1", steps = [{ do = "PromoteUnit", unit = 0 }, { choices = "We are grateful.", do = "ShowPopup", textKey = "@LEARNDONE" }] }, { pin = "2", steps = [{ choices = "Of course.", do = "ShowPopup", textKey = "@LEARNMASTER" }] }, { pin = "default", steps = [{ args = { str0 = "$lcrim_tribe" }, choices = "We shall return.", do = "ShowPopup", textKey = "@LEARNCRIMINAL" }] }], do = "Switch" }] }], do = "Switch" }]
  comments = [{ text = "Colonist training (spec/systems/training.md). Three routes to expertise, here as a Switch on method: 0=NATIVE LEARNING (live in a village): a free colonist/indentured servant becomes a master of the local skill (@LEARNDONE); a petty criminal is too unskilled (@LEARNSLOW); an already-skilled colonist is refused (@LEARNMASTER). 1=SCHOOL: a master teaches an unskilled colonist over 4/6/8 turns by skill tier (Schoolhouse/College/University). 2=VETERAN: a combat winner is promoted (Washington auto-promotes; else random_int(1,S) <= winner strength). PromoteUnit applies the class change.", x = 20, y = -130 }]
}
