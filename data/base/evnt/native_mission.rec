record evnt.native_mission {
  name     = "Native Mission"
  vars     = [{ do = "Formula", expr = "(natives.tension>=25)+(natives.tension>=50)+(natives.tension>=75)", id = "band" }, { args = { a = "$quality" }, do = "Formula", expr = "roll(0,15) < (a + 2)", id = "conv" }, { args = { index = "$z" }, column = "level", do = "TableLookup", id = "quality", section = "@TRIBES" }, { do = "GetState", id = "year", path = "game.year" }, { do = "Constant", id = "z", value = 0 }]
  steps    = [{ do = "OnMissionAttempt" }, { args = { value = "$band" }, branches = [{ pin = "1", steps = [{ args = { num0 = "$year" }, branches = [{ pin = "Preach the Word", steps = [{ args = { cond = "$conv" }, branches = [{ pin = "true", steps = [{ do = "SpawnUnit", power = "0", type = "Colonists" }, { choices = "Welcome, brother.", do = "ShowPopup", textKey = "@INDIANSCONVERT" }] }], do = "Branch" }] }], choices = "Preach the Word", do = "ShowPopup", textKey = "@MISSION1" }] }, { pin = "2", steps = [{ args = { num0 = "$year" }, branches = [{ pin = "Preach the Word", steps = [{ args = { cond = "$conv" }, branches = [{ pin = "true", steps = [{ do = "SpawnUnit", power = "0", type = "Colonists" }, { choices = "Welcome, brother.", do = "ShowPopup", textKey = "@INDIANSCONVERT" }] }], do = "Branch" }] }], choices = "Preach the Word", do = "ShowPopup", textKey = "@MISSION2" }] }, { pin = "3", steps = [{ args = { num0 = "$year" }, branches = [{ pin = "Preach the Word", steps = [{ args = { cond = "$conv" }, branches = [{ pin = "true", steps = [{ do = "SpawnUnit", power = "0", type = "Colonists" }, { choices = "Welcome, brother.", do = "ShowPopup", textKey = "@INDIANSCONVERT" }] }], do = "Branch" }] }], choices = "Preach the Word", do = "ShowPopup", textKey = "@MISSION3" }] }, { pin = "default", steps = [{ args = { num0 = "$year" }, branches = [{ pin = "Preach the Word", steps = [{ args = { cond = "$conv" }, branches = [{ pin = "true", steps = [{ do = "SpawnUnit", power = "0", type = "Colonists" }, { choices = "Welcome, brother.", do = "ShowPopup", textKey = "@INDIANSCONVERT" }] }], do = "Branch" }] }], choices = "Preach the Word", do = "ShowPopup", textKey = "@MISSION0" }] }], do = "Switch" }]
  comments = [{ text = "Mission founding + conversion (spec/systems/natives.md func_0572E6), rebuilt. Reaction follows the tribe's attitude band (@MISSION0 curiosity .. @MISSION3 hostility). Conversion roll: P(convert)=(TribeQuality+2)/15 -- roll(0,15) < threshold; TribeQuality is read live from @TRIBES[tribe].level (here tribe 0 = Incas).", x = 20, y = -110 }]
}
