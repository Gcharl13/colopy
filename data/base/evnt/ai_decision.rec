record evnt.ai_decision {
  name     = "AI Nerve / Demand Check"
  vars     = [{ args = { a = "$att", b = "$dem" }, do = "Formula", expr = "!( (floor(a/4) > b) && (b > 12) && (roll(0,4) != 0) )", id = "acts" }, { do = "Formula", expr = "30 + roll(0,50)", id = "att" }, { do = "Formula", expr = "10 + roll(0,12)", id = "dem" }, { do = "GetState", id = "natEng", path = "@NATIONALITY[0].name" }, { do = "GetState", id = "natFr", path = "@NATIONALITY[1].name" }]
  steps    = [{ do = "OnTestFire" }, { args = { cond = "$acts" }, branches = [{ pin = "false", steps = [{ args = { str0 = "$natEng", str1 = "$natFr" }, do = "Notify", textKey = "@OLDPEACEMANLY" }] }, { pin = "true", steps = [{ a = "1", b = "0", do = "DeclareWar" }, { args = { str0 = "$natEng", str1 = "$natFr" }, do = "Notify", textKey = "@DECLAREWAR" }] }], do = "Branch" }]
  comments = [{ text = "AI decision-making: does a rival power follow through on a demand, or lose its nerve? (spec/systems/ai.md; nerve check ai_acts BYTE_VERIFIED sim/diplomacy.cpp.) restrained = (attitude>>2 > demand_score) AND (demand_score > 12) AND (random(0,4) != 0); the AI ACTS = not restrained. So a calm, cautious AI (high attitude toward you) with a big demand still backs down 4 times in 5. attitude>>2 is floor(attitude/4). Here power 1 (French) weighs a demand against player 0 (English): nerve holds -> Declare War + the real @DECLAREWAR message; nerve fails -> the @OLDPEACEMANLY 'we elect not to drive you' message. attitude/demand are contextual inputs (driven by rolls here); the formula + constants are inline, no magic-number nodes.", x = 20, y = -170 }]
}
