record evnt.demo_treasure {
  name  = "Demo: lost-city treasure reward"
  vars  = [{ do = "Roll", id = "roll", max = 240, min = 30 }]
  steps = [{ do = "OnTestFire" }, { args = { amount = "$roll" }, do = "GrantGold", power = "0" }, { choices = "Praise be to God,Onward", do = "ShowPopup", textKey = "@LOSTCITY3", woodcut = "WDCUT04" }]
}
