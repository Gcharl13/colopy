record evnt.combat {
  name     = "Combat Resolution"
  vars     = [{ do = "GetState", id = "atk", path = "unit0.attack" }, { do = "Constant", id = "c1", value = 1 }, { args = { a = "$roll", b = "$atk" }, do = "Compare", id = "cmp", op = "<=" }, { args = { a = "$def0", b = "$tdef" }, do = "Math", id = "def", op = "+" }, { do = "GetState", id = "def0", path = "unit1.defense" }, { args = { atk = "$atk", def = "$def" }, do = "CombatOdds", id = "odds" }, { args = { max = "$total", min = "$c1" }, do = "Roll", id = "roll" }, { do = "GetState", id = "tdef", path = "unit1.terraindef" }, { args = { a = "$atk", b = "$def" }, do = "Math", id = "total", op = "+" }]
  steps    = [{ do = "OnTestFire" }, { args = { cond = "$cmp" }, branches = [{ pin = "false", steps = [{ do = "DemoteUnit", unit = 0 }, { args = { num0 = "$odds" }, body = "The attack is thrown back -- the attacker had only a {%NUMBER0%%} chance.", choices = "Regroup", do = "ShowPopup", title = "Defeat", woodcut = "WDCUT10" }] }, { pin = "true", steps = [{ do = "DemoteUnit", unit = 1 }, { args = { num0 = "$odds" }, body = "The attacker carries the field! (a {%NUMBER0%%} win chance vs {unit1.defense}+{unit1.terraindef} terrain defense)", choices = "Huzzah!", do = "ShowPopup", title = "Victory!", woodcut = "WDCUT10" }] }], do = "Branch" }]
  comments = [{ text = "Land combat (spec/systems/combat.md func_05CA7E land decider + func_05B2C2 consequence applier). odds = ATK/(ATK+DEF); act-mode roll = random_int(1, ATK+DEF) <= ATK => attacker wins. DEF folds in the terrain/fort defense bonus ($TERRAIN Defensive: forests 2 / Hills 4 / Mountains 6, BYTE_VERIFIED). Loser walks down the demotion ladder (Soldiers->Colonist, Dragoons->Soldiers, ...) or is destroyed if it has no demotion. Demo resolves unit0 (attacker) attacking unit1 (defender); CombatOdds shows the win %.", x = 30, y = -130 }]
}
