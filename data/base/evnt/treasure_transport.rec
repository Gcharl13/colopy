record evnt.treasure_transport {
  name     = "Treasure Transport"
  vars     = [{ do = "Formula", expr = "power0.gold - power0.gold * (ff.10 ? power0.tax : min(max(5*game.difficulty+50, 2*power0.tax), 90)) / 100", id = "keep" }]
  steps    = [{ do = "OnTestFire" }, { branches = [{ pin = "Keep it in the New World", steps = [{ body = "You keep the treasure in the New World, awaiting a galleon of your own to ship it.", choices = "As you wish.", do = "ShowPopup", title = "Treasure Kept" }] }, { pin = "Let the Crown ship it", steps = [{ args = { amount = "$keep" }, do = "GrantGold", power = "0" }, { body = "The Crown's galleon delivers your treasure to Europe, less its cut. You now hold {power0.gold} gold.", choices = "Very well.", do = "ShowPopup", title = "Treasure Delivered" }] }], choices = "Let the Crown ship it,Keep it in the New World", do = "ShowPopup", speaker = "King", textKey = "@KINGGALLEON2" }]
  comments = [{ text = "Treasure transport to Europe -- the King's cut (spec/systems/natives.md func_05C878). @KINGGALLEON2 is an OFFER: with no galleon of your own, the Crown proposes to ship the treasure and take a cut. Cut% = Hernan Cortes (ff.10) ? tax : min(max(5*diff+50, 2*tax), 90). You KEEP treasure - treasure*cut/100 -- but only if you accept; declining ships nothing and grants nothing (the treasure stays in the New World). One Formula computes the kept amount; the grant is gated behind the accept choice. (treasure proxied by the treasury here.)", x = 20, y = -110 }]
}
