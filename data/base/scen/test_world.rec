record scen.test_world {
  name               = "Test World (pre-founded colonies)"
  map                = "AMER2.MP"
  year               = 1492
  season             = 0
  end_year           = 1800
  start_gold         = 500
  default_nation     = 0
  default_difficulty = 1
  colonies           = [{ buildings = [9, 35, 37], center_food = 5, workers = [{ good = 0, profession = 0, terrain = 2, tile = 0 }, { good = 0, profession = 0, terrain = 2, tile = 6 }, { good = 5, profession = 5, terrain = 8, tile = 4 }, { good = 16, profession = 13, tile = -1 }, { good = 18, profession = 17, tile = -1 }], x = 20, y = 22 }, { buildings = [9, 35], center_food = 5, workers = [{ good = 0, profession = 0, terrain = 2, tile = 0 }, { good = 6, profession = 6, terrain = 28, tile = 4 }, { good = 16, profession = 13, tile = -1 }], x = 34, y = 42 }]
  units              = [{ at_colony = 0, dx = 0, dy = 0, type = "Soldiers" }, { at_colony = 0, dx = 1, dy = 0, type = "Pioneers" }, { at_colony = 0, dx = 0, dy = 1, goto_colony = 1, type = "Colonists" }, { at_colony = 0, on_water_adjacent = 1, type = "Caravel" }, { owner = 1, type = "Colonists", x = 5, y = 4 }, { owner = 1, type = "Colonists", x = 6, y = 4 }, { owner = 1, type = "Soldiers", x = 5, y = 4 }, { owner = 1, type = "Scouts", x = 6, y = 5 }, { owner = 2, type = "Colonists", x = 11, y = 26 }, { owner = 2, type = "Colonists", x = 12, y = 26 }, { owner = 2, type = "Soldiers", x = 11, y = 26 }, { owner = 2, type = "Scouts", x = 12, y = 27 }, { owner = 3, type = "Colonists", x = 53, y = 48 }, { owner = 3, type = "Colonists", x = 54, y = 48 }, { owner = 3, type = "Soldiers", x = 53, y = 48 }, { owner = 3, type = "Scouts", x = 54, y = 49 }]
  notes              = "Authored starting conditions as data (B10): the opening seeds the state tables from this scenario. nation/difficulty are picked at the new-game screen; everything else (map, year, starting gold, colonies, units) is here. Colony coords are snapped to the nearest land tile at load. Unit 'type' resolves through @UNIT (row index == type id). Each colony has colonists (workers) and built buildings: a worker is a colonist with a profession (@JOB id), a good (0..7 raw tile good / 16 Hammers / 17 Crosses / 18 Bells), and a ring tile (0=NW..7=SE, -1 = building slot); a tile worker's terrain is derived from the map at that ring tile so yields reflect the real map. Production (food/bells/hammers/crosses/goods) is COMPUTED from these each turn, not seeded. buildings = built @BUILDING ids."
}
