<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="42">
<CheatEntries>
<CheatEntry><ID>0</ID><Description>"── LOCATE VICEROY (activate after loading a game; auto-runs on table load) ──"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if VICEROY == nil then error('table Lua not loaded — answer Yes to the table-script prompt') end
VICEROY.locate()
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if VICEROY then VICEROY.stop() end
{$asm}
</AssemblerScript></CheatEntry>
