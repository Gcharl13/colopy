{
  "id": "trade_route",
  "name": "Trade Route",
  "nodes": [
    {
      "id": "note",
      "type": "Comment",
      "x": 20,
      "y": -90,
      "params": {
        "text": "Selling goods in Europe is a PLAYER MENU COMMAND (OnPlayerCommand), not an automatic per-turn sale. When invoked it sells the cargo at the European price less the Crown's tax cut and credits the net to the treasury (@ shows the sale)."
      }
    },
    {
      "id": "trig",
      "type": "OnPlayerCommand",
      "x": 20,
      "y": 40,
      "params": {}
    },
    {
      "id": "net",
      "type": "Formula",
      "x": 20,
      "y": 150,
      "params": {
        "expr": "100*@CARGO[10].price_start1 - 100*@CARGO[10].price_start1*power0.tax/100"
      }
    },
    {
      "id": "taxtaken",
      "type": "Formula",
      "x": 20,
      "y": 220,
      "params": {
        "expr": "100*@CARGO[10].price_start1*power0.tax/100"
      }
    },
    {
      "id": "credit",
      "type": "GrantGold",
      "x": 220,
      "y": 40,
      "params": {
        "power": "0"
      }
    },
    {
      "id": "pop",
      "type": "ShowPopup",
      "x": 420,
      "y": 40,
      "params": {
        "title": "Goods Sold in Europe",
        "body": "The cargo sells for {%NUMBER0} gold after the Crown takes {%NUMBER1} in tax.",
        "choices": "Good trade."
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "trig",
        "pin": "out"
      },
      "to": {
        "node": "credit",
        "pin": "in"
      }
    },
    {
      "from": {
        "node": "net",
        "pin": "value"
      },
      "to": {
        "node": "credit",
        "pin": "amount"
      }
    },
    {
      "from": {
        "node": "credit",
        "pin": "out"
      },
      "to": {
        "node": "pop",
        "pin": "in"
      }
    },
    {
      "from": {
        "node": "net",
        "pin": "value"
      },
      "to": {
        "node": "pop",
        "pin": "num0"
      }
    },
    {
      "from": {
        "node": "taxtaken",
        "pin": "value"
      },
