{
  "id": "kings_tax",
  "name": "King's Tax Demand",
  "nodes": [
    {
      "id": "note",
      "type": "Comment",
      "x": 20,
      "y": -90,
      "params": {
        "text": "King's tax demand (spec/systems/king.md func_036138/034AE0/034318), rebuilt with Formula + Notify. Cadence, raise, severity and pretext bucket are each ONE Formula node referencing live variables; the four pretexts are the real @KING* messages with %NUMBER0=raise, %NUMBER1=new rate."
      }
    },
    {
      "id": "trig",
      "type": "OnTurnStart",
      "x": 20,
      "y": 40,
      "params": {}
    },
    {
      "id": "due",
      "type": "Formula",
      "x": 200,
      "y": 140,
      "params": {
        "expr": "game.turn >= 30 && (game.turn % (game.year>=1750 ? 9 : game.year>=1700 ? 12 : game.year>=1600 ? 15 : 18)) == 0 && power0.tax <= 85"
      }
    },
    {
      "id": "br",
      "type": "Branch",
      "x": 420,
      "y": 40,
      "params": {}
    },
    {
      "id": "delta",
      "type": "Formula",
      "x": 200,
      "y": 260,
      "params": {
        "expr": "(game.difficulty - game.difficulty%2)*2 + 4"
      }
    },
    {
      "id": "newTax",
      "type": "Formula",
      "x": 200,
      "y": 330,
      "params": {
        "expr": "min(power0.tax + a, 75)"
      }
    },
    {
      "id": "sev",
      "type": "Formula",
      "x": 200,
      "y": 430,
      "params": {
        "expr": "roll(1,1000) + (2*revolution.sol - power0.tax)*5 + power0.gold/100 + power0.econ_strength + floor(game.turn/30)"
      }
    },
    {
      "id": "bucket",
      "type": "Formula",
      "x": 420,
      "y": 430,
      "params": {
        "expr": "(a>=650) + (a>=950) + (a>=1100)"
      }
    },
