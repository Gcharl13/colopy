      "type": "Branch",
      "x": 220,
      "y": 40,
      "params": {}
    },
    {
      "id": "bandcol",
      "type": "Formula",
      "x": 20,
      "y": 250,
      "params": {
        "expr": "2 + congress.era_band"
      }
    },
    {
