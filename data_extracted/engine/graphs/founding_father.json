{
  "id": "founding_father",
  "name": "Founding Father Offer",
  "nodes": [
    {
      "id": "note",
      "type": "Comment",
      "x": 20,
      "y": -120,
      "params": {
        "text": "Continental Congress (spec/systems/founding_fathers.md), rebuilt table-driven. Trigger: congress.bells >= congress.cost (the byte-verified bell curve). Selection = era-weighted random over un-owned fathers; the 3 @FATHERS weight columns ARE the era bands, read live by TableLookup with col = 2 + era_band -- edit a father's weights in the Tables tab and the offer odds change. Modeled over one representative father per category (rows 0/5/11/15/21)."
      }
    },
    {
      "id": "trig",
      "type": "OnTurnStart",
      "x": 20,
      "y": 40,
      "params": {}
    },
    {
      "id": "gate",
      "type": "Formula",
      "x": 20,
      "y": 150,
      "params": {
        "expr": "congress.bells >= congress.cost"
      }
    },
    {
