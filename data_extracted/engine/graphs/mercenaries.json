{
  "id": "mercenaries",
  "name": "Mercenary Offer",
  "nodes": [
    {
      "id": "note",
      "type": "Comment",
      "x": 20,
      "y": -90,
      "params": {
        "text": "Mercenary offer (spec/systems/mercenary.md): odds are wartime 1-in-3 (after independence) vs peacetime 1-in-21, in one Formula. On an offer the King presents @MERCENARIES; Hire -> a veteran stack arrives (@MERCS); declining is silent. The FORCE depends on the state: wartime spawns Continental Army/Cavalry + Artillery, peacetime spawns Veteran Dragoons + Artillery -- so the hire branches on revolution.declared."
      }
    },
    {
      "id": "trig",
      "type": "OnTurnStart",
      "x": 20,
      "y": 40,
      "params": {}
    },
    {
      "id": "offer",
      "type": "Formula",
      "x": 20,
      "y": 150,
      "params": {
        "expr": "revolution.declared ? (roll(1,3)==1) : (roll(1,21)==1)"
      }
    },
    {
      "id": "br",
      "type": "Branch",
      "x": 220,
      "y": 40,
      "params": {}
    },
    {
      "id": "pop",
