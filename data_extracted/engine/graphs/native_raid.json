{
  "id": "native_raid",
  "name": "Native Raid on Colony",
  "nodes": [
    { "id": "trig", "type": "OnTurnStart", "x": 30,  "y": 40,  "params": {} },
    { "id": "roll", "type": "Roll",     "x": 30,  "y": 150, "params": { "min": 1, "max": 4 } },
    { "id": "c3",   "type": "Constant", "x": 30,  "y": 280, "params": { "value": 3 } },
    { "id": "cmp",  "type": "Compare",  "x": 220, "y": 200, "params": { "op": ">=" } },
    { "id": "br",   "type": "Branch",   "x": 410, "y": 60,  "params": {} },
    { "id": "loss", "type": "Constant", "x": 410, "y": 250, "params": { "value": -200 } },
    { "id": "gold", "type": "GrantGold","x": 600, "y": 40,  "params": { "power": "0" } },
    { "id": "pop",  "type": "ShowPopup","x": 800, "y": 40,
      "params": { "title": "Native Raid!", "body": "Braves raid your colony and make off with your gold.", "choices": "We will rebuild" } },
    { "id": "calm", "type": "Log", "x": 600, "y": 200, "params": { "message": "The natives grumble but do not raid this turn." } }
  ],
  "edges": [
    { "from": { "node": "trig", "pin": "out" },   "to": { "node": "br",  "pin": "in" } },
    { "from": { "node": "roll", "pin": "value" }, "to": { "node": "cmp", "pin": "a" } },
    { "from": { "node": "c3",   "pin": "value" }, "to": { "node": "cmp", "pin": "b" } },
    { "from": { "node": "cmp",  "pin": "value" }, "to": { "node": "br",  "pin": "cond" } },
    { "from": { "node": "br",   "pin": "true" },  "to": { "node": "gold","pin": "in" } },
    { "from": { "node": "loss", "pin": "value" }, "to": { "node": "gold","pin": "amount" } },
    { "from": { "node": "gold", "pin": "out" },   "to": { "node": "pop", "pin": "in" } },
    { "from": { "node": "br",   "pin": "false" }, "to": { "node": "calm","pin": "in" } }
  ]
}
