{
  "id": "colony",
  "name": "Colony Screen",
  "background": "COLONY",
  "size": [320, 200],
  "widgets": [
    { "id": "title", "type": "text", "rect": [70, 1, 240, 8], "color": "82,138,49", "text": "Jamestown.  Year {game.year}.  Gold: {power0.gold}" },
