    { "id": "soll",  "type": "text", "rect": [10, 24, 120, 8], "color": "255,243,93", "text": "Sons of Liberty: {colony0.sol}%" },
    { "id": "church","type": "sprite", "rect": [24, 40, 32, 32], "sheet": "BUILDING", "frame": 1 },
    { "id": "townh", "type": "sprite", "rect": [64, 40, 32, 32], "sheet": "BUILDING", "frame": 4 },
    { "id": "exit",  "type": "button", "rect": [284, 182, 32, 12], "color": "255,255,255", "text": "Exit", "onClick": "" }
