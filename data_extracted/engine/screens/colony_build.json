{
  "id": "colony_build",
  "name": "Colony Construction",
  "background": "COLONY",
  "size": [
    320,
    200
  ],
  "widgets": [
    {
      "id": "title",
      "type": "text",
      "rect": [ 70, 1, 240, 8 ],
      "color": "82,138,49",
      "text": "Jamestown.  Year {game.year}.  Gold: {power0.gold}"
    },
    {
      "id": "now",
      "type": "text",
      "rect": [ 10, 16, 300, 8 ],
      "color": "255,243,93",
