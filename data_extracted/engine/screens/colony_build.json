    },
    {
      "id": "menu",
      "type": "buildmenu",
      "rect": [ 10, 28, 300, 74 ],
      "color": "220,220,220",
      "colony": 0
    },
    {
      "id": "stock",
      "type": "text",
      "rect": [ 10, 106, 300, 8 ],
      "color": "210,190,120",
      "text": "Warehouse -- Sugar {colony0.stockpile.1}  Cotton {colony0.stockpile.3}  Furs {colony0.stockpile.4}  Lumber {colony0.stockpile.5}  Ore {colony0.stockpile.6}   Net food/turn {colony0.food}   Colonists {colony0.workers}"
    },
    {
      "id": "rush",
      "type": "button",
      "rect": [ 10, 120, 90, 12 ],
      "color": "255,255,255",
      "text": "Rush with gold",
      "onClick": "colony_rush_buy"
    },
    {
      "id": "exit",
      "type": "button",
      "rect": [ 284, 182, 32, 12 ],
      "color": "255,255,255",
      "text": "Exit",
      "onClick": "goto_mainmenu"
    }
  ]
}
