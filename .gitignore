# --- never commit verbatim executables/binaries ---
# The DOS exes live ONLY as bin/*.b64 (transformed). reconstitute.py rebuilds the
# real .EXE locally; those (and any other binary) must stay out of git.
*.exe
*.EXE
*.dll
*.com

# generated graph + caches (regenerable)
graphify-out/
.dos_db.json
.win_index.json

# python
__pycache__/
*.pyc

# os/editor cruft
Thumbs.db
.DS_Store
*.swp

# reconstituted DOS exes (rebuilt by bin/reconstitute.py)
raw/

# tool-generated disasm outputs (regenerable via tools/disasm_full.py etc.)
extracted/

# no tracked binaries (data ships as text/JSON)
*.xlsx
# never commit the excluded pre-split corpus tree (untracked leftover)
reverse_engineered/

# regenerable visualization (rebuilt by tools/build_coverage_map.py)
coverage_map.html

# DOSBox capture working tree (RAM dumps, logs, driving screenshots) — regenerable,
# matched outputs are committed under docs/screens/ (colony_live_1505.png etc.)
scratchpad/dbx/
code/VICEROY/flat/

# Port: regenerable from the user's own col.zip; contains original game art.
port/assets/
port/dist/
port/_shots/

# DOSBox harness working files (game/ is extracted from col.zip, see its README)
tools/dosbox_harness/game/
tools/dosbox_harness/shots/
tools/dosbox_harness/cap/
tools/dosbox_harness/dosbox.conf
tools/dosbox_harness/dosbox.log

# Phase 6: the microSD asset pack is regenerable (tools/gen_sd_pack.py)
cport/pak/
cport/arduino/colopy/colopy_pak_blob.c
# audio milestone: raw per-id captures + local pak are regenerable
tools/audio/captures/
cport/pak/COLAUDIO.PAK

# tools/ino_mock regenerates this from the sketch on every run
tools/ino_mock/sketch_test.cpp

# Sketch zips handed to the user for flashing: regenerable from
# cport/arduino_p4/colopy_p4 at the commit named in the filename.
colopy_p4_*.zip

# DOSBox harness working files: shots/ is regenerable via
# `make census-capture`; the census keeps its own committed baseline under
# docs/screens/census/.
tools/dosbox_harness/shots/
tools/dosbox_harness/dosbox.log
tools/dosbox_harness/dosbox.conf
